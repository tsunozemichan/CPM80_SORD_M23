                                ;*** AILZ80ASM *** Z-80 Assembler, version 1.0.31.0, LST:Full:4
                                
                                ;==============================================================
                                ; BIOS of CP/M-80 ver2.2 for SORD M23 ver.20260523
                                ;   The creator of the machine-dependent part is tsunozemi@twitter
                                ;   Display and keyboard drivers are added by tsunozemi@twitter 2026/05/23
                                ;==============================================================
                                
       003A                     msize   EQU 58  ;cp/m version memory size in kilobytes
                                
                                ;
                                ;   "bias" is address offset from 3400h for memory systems
                                ;   than 16k (referred to as"b" throughout the text)
                                ;
       9800                     bias    EQU (MSIZE-20)*1024
       CC00                     ccp     EQU 3400H+BIAS  ;base of ccp
       D406                     bdos    EQU CCP+806H    ;base of bdos
       E200                     bios    EQU CCP+1600H   ;base of bios
       0004                     cdisk   EQU 0004H   ;current disk number 0=a,... l5=p
       0003                     iobyte  EQU 0003H   ;intel i/o byte
                                
                                ;
                                ; FDC I/O ports
                                ;
       00C0                     FDC_COMMAND_REG EQU 0C0H
       00C0                     FDC_STATUS_REG  EQU FDC_COMMAND_REG
       00C1                     FDC_TRACK_REG   EQU 0C1H
       00C2                     FDC_SECTOR_REG  EQU 0C2H
       00C3                     FDC_DATA_REG    EQU 0C3H
       00C4                     DMA_ADDRESS     EQU 0C4H
       00C5                     FDC_CONTROL_REG EQU 0C5H
       00C6                     DMA_BANK_SEL    EQU 0C6H
                                
                                ; WBOOT Transfer Address
       EA49                     WBOOT_ADDRESS_L EQU wboot_address
       EA4A                     WBOOT_ADDRESS_H EQU WBOOT_ADDRESS_L + 1H
                                
                                ;
                                ; CRTC ports
                                ;
       F800                     VRAM_TXT_TOP        EQU F800H ; VRAMのテキストエリアの先頭アドレス
       FFD0                     VRAM_TXT_END        EQU FFD0H ; VRAMのテキストエリアの終端アドレス
       F000                     VRAM_ATR_TOP        EQU F000H ; VRAMのアトリビュートエリアの先頭アドレス
       00F0                     CRTC_ADDRESS_PORT   EQU F0H ; CRTCアドレスポート
       00F1                     CRTC_VALUE_PORT     EQU F1H ; CRTC値ポート
                                
                                ; Display Constants
       0050                     NUMBER_OF_CHARACTER_AT_LINE EQU 80 ; 80文字モードの1行の文字数
                                
                                ; Ascii code Constants
       0007                     BEL EQU 07H ; Bell
       0008                     BS  EQU 08H ; Back Space
       0009                     HT  EQU 09H ; Horizontal Tab
       000A                     LF  EQU 0AH ; Line Feed
       000B                     VT  EQU 0BH ; Vertical Tab
       000C                     FOF EQU 0CH ; Formfeed
       000D                     CR  EQU 0DH ; Carriage Return
       001B                     ESC EQU 1BH ; Escape
       007F                     DEL EQU 7FH ; Delete
                                
                                
                                ; Keyboard scan buffer
                                ; キーボードスキャンの実装上、末尾のアドレスが00であることが条件になっている。
       EE00                     KEYBOARD_SCAN_BUFFER EQU 0EE00H
                                
                                
                                ; CTC Timer Initialization for CP/M
                                ; Ch0を10ms周期のタイマーとして設定（IM2割り込み）
                                
       00FC                     CTC_CH0     EQU 0FCh        ; CTC Ch0ポート
       0000                     VEC_BASE    EQU 00h         ; CTCベクタベース
       FF00                     IM2_TABLE   EQU 0FF00h      ; IM2割り込みベクタテーブル
       0000                     CTC_VEC_CH0 EQU 00h         ; Ch0のベクタオフセット
                                
                                ;==============================================================
                                ; CP/M to host disk constants
                                ;==============================================================
       0800                     blksiz equ 2048 ;CP/M allocation size
       0100                     hstsiz equ 256  ;host disk sector size
       0010                     hstspt equ 16   ;host disk sectors/trk
       0002                     hstblk equ hstsiz/128   ;CP/M sects/host buff
       0020                     cpmspt equ hstblk * hstspt  ;CP/M sectors/track
       0001                     secmsk equ hstblk-1 ;sector mask
                                ;smask  hstblk  ;compute sector mask
       0001                     secshf equ 1    ;log2(hstblk)
                                
                                ;==============================================================
                                ; BDOS constants on entry to write
                                ;==============================================================
       0000                     wrall equ 0 ;write to allocated
       0001                     wrdir equ 1 ;write to directory
       0002                     wrual equ 2 ;write to unallocated
                                
000000 E200                             ORG BIOS    ;origin of this program
       002C                     nsects  EQU ($-CCP)/128 ;warm start sector count
                                ;
                                ;   jump vector for individual subroutines
                                ;
000000 E200 C382E2          10          JP  boot    ;cold start
000003 E203 C3A5E2          10  wboote: JP  wboot   ;warm start
000006 E206 C318E3          10          JP  const   ;console status
000009 E209 C31BE3          10          JP  conin   ;console character in
00000C E20C C325E3          10          JP  conout  ;console character out
00000F E20F C333E3          10          JP  list    ;list character out
000012 E212 C337E3          10          JP  punch   ;punch character out
000015 E215 C339E3          10          JP  reader  ;reader character out
000018 E218 C33EE3          10          JP  home    ;move head to home position
00001B E21B C349E3          10          JP  seldsk  ;select disk
00001E E21E C362E3          10          JP  settrk  ;set track number
000021 E221 C368E3          10          JP  setsec  ;set sector number
000024 E224 C370E3          10          JP  setdma  ;set dma address
000027 E227 C376E3          10          JP  read    ;read disk
00002A E22A C38AE3          10          JP  write   ;write disk
00002D E22D C335E3          10          JP  listst  ;return list status
000030 E230 C36DE3          10          JP  sectran ;sector translate
                                
                                ;
                                ;   fixed data tables for four-drive standard
                                ;   ibm-compatible 8" disks
                                ;
                                ;   disk Parameter header for disk 00
000033 E233 00000000            dpbase: dw  0h, 0000h
000037 E237 00000000                    dw  0000h, 0000h
00003B E23B CFEB73E2                    dw  dirbf, dpblk
00003F E23F CBEC4FEC                    dw  chk00, all00
                                ;   disk parameter header for disk 01
000043 E243 00000000                    dw  0h, 0000h
000047 E247 00000000                    dw  0000h, 0000h
00004B E24B CFEB73E2                    dw  dirbf, dpblk
00004F E24F DBEC6EEC                    dw  chk01, all01
                                ;   disk parameter header for disk 02
000053 E253 00000000                    dw  0h, 0000h
000057 E257 00000000                    dw  0000h, 0000h
00005B E25B CFEB73E2                    dw  dirbf, dpblk
00005F E25F EBEC8DEC                    dw  chk02, all02
                                ;   disk parameter header for disk 03
000063 E263 00000000                    dw  0h, 0000h
000067 E267 00000000                    dw  0000h, 0000h
00006B E26B CFEB73E2                    dw  dirbf, dpblk
00006F E26F FBECACEC                    dw  chk03, all03
                                
                                ;
                                ; SORD M23 1DD 80 track, 256 byte/sector, 16 sector, 1 side, 2048 byte/data block
                                ;
                                ;
       E273                     dpblk:  ;DISK PARM BLOCK
000073 E273 2000                        DW  32      ;SEC PER TRACK(by CP/M logical sector(128byte))
000075 E275 04                          DB  4       ;BLOCK SHIFT
000076 E276 0F                          DB  15      ;BLOCK MASK
000077 E277 01                          DB  1       ;EXTNT MASK
000078 E278 9B00                        DW  155     ;DISK SIZE-1
00007A E27A 3F00                        DW  63      ;DIRECTORY MAX
00007C E27C 80                          DB  128     ;ALLOC0
00007D E27D 00                          DB  0       ;ALLOC1
00007E E27E 1000                        DW  16      ;CHECK SIZE
000080 E280 0200                        DW  2       ;OFFSET
                                ;
                                ;   end of fixed tables
                                ;
                                
                                ;   individual subroutines to perform each function
       E282                     boot:   ;simplest case is to just perform parameter initialization
000082 E282 AF               4          XOR A   ;zero in the accum
000083 E283 320300          13          LD  (iobyte),A  ;clear the iobyte
000086 E286 320400          13          LD  (cdisk),A   ;select disk zero
000089 E289 32BBEA          13          LD  (hstact),A  ;host buffer inactive
00008C E28C 32BDEA          13          LD  (unacnt),A  ;clear unalloc count
                                ;
00008F E28F CD50E5          17          CALL CRT_INIT   ; CRT初期化
000092 E292 CD37E5          17          CALL FDC_INIT   ; FDC初期化
000095 E295 CD3DE5          17          CALL KBD_INIT   ; キーボード初期化
                                ;
000098 E298 F5              11          PUSH AF
000099 E299 E5              11          PUSH HL
00009A E29A 214EEA          10          LD HL,OPENMSG
00009D E29D CD10E7          17          CALL STRING_OUT
0000A0 E2A0 E1              10          POP HL
0000A1 E2A1 F1              10          POP AF
                                
                                        ; CALL CTC_INIT ; CTC初期化
                                
                                
0000A2 E2A2 C3F6E2          10          JP  gocpm   ;initialize and go to cp/m
                                
                                ;==============================================================
                                ; worm boot process
                                ;==============================================================
       E2A5                     wboot:  ;simplest case is to read the disk until all sectors loaded
                                
                                        ; WBOOTでは、CPPとBDOSをディスクから再ロードする。
                                        ; BIOSはロードしない（すると壊れる）。
                                
0000A5 E2A5 318000          10          LD  SP, 80h ;use space below buffer for stack
0000A8 E2A8 0E00             7          LD  C, 0    ;select disk 0
0000AA E2AA CD49E3          17          CALL    seldsk
                                
                                
                                        ; FDC initialize
0000AD E2AD 3E51             7          LD A,51H
0000AF E2AF 32C500          13          LD (FDC_CONTROL_REG),A
                                
                                        ; DMA Bank Selectを0に設定
0000B2 E2B2 AF               4          XOR A ; A=0
0000B3 E2B3 D3C6            11          OUT (DMA_BANK_SEL), A
                                
                                        ; DMAの転送アドレスを58k memory modelにおけるccpのアドレス(CC00H)にセットする。
                                
0000B5 E2B5 3ECC             7          LD A,0CCH ; CC00Hは58K memory model
0000B7 E2B7 324AEA          13          LD (WBOOT_ADDRESS_H),A
0000BA E2BA 3E00             7          LD A,00H
0000BC E2BC 3249EA          13          LD (WBOOT_ADDRESS_L),A
                                        ;
                                        ; 1st READ
                                        ; 現在は、トラック22、セクタ9～16からトラック23、セクタ1～14という
                                        ; 中途半端な位置にCPM.SYSを配置している。
0000BF E2BF 1E16             7          LD E,22 ; TARGET TRACK is No.22
       E2C1                     DO_SEEK_WBOOT0:
0000C1 E2C1 CDE4E4          17          CALL SEEK
0000C4 E2C4 2802            12          JR Z,GO_DMA_WBOOT0
0000C6 E2C6 18F9            12          JR DO_SEEK_WBOOT0
       E2C8                     GO_DMA_WBOOT0:
0000C8 E2C8 0608             7          LD B,08 ; LOOP COUNT is 8 sectors
0000CA E2CA 0E09             7          LD C,09 ; INITIAL SECTOR NO. is 9 to 16 sector reading
                                ;
       E2CC                     READ_LOOP_WBOOT0:
0000CC E2CC CD26E5          17          CALL GO_DMA_AND_READ_WBOOT0
0000CF E2CF 0C               4          INC C
0000D0 E2D0 3A4AEA          13          LD A,(WBOOT_ADDRESS_H) ; memory address of DMA transfer address
0000D3 E2D3 3C               4          INC A ; 256 byte incriment
0000D4 E2D4 324AEA          13          LD (WBOOT_ADDRESS_H),A
0000D7 E2D7 10F3            13          DJNZ READ_LOOP_WBOOT0
                                
                                        ;
                                        ; 2nd READ
                                        ;
0000D9 E2D9 1E17             7          LD E,23  ; TARGET TRACK No.23
       E2DB                     DO_SEEK_WBOOT1:
0000DB E2DB CDE4E4          17          CALL SEEK
0000DE E2DE 2802            12          JR Z,GO_DMA_WBOOT1
0000E0 E2E0 18F9            12          JR DO_SEEK_WBOOT1
       E2E2                     GO_DMA_WBOOT1:
0000E2 E2E2 060E             7          LD B,014 ; LOOP COUNT is 14 sectors
0000E4 E2E4 0E01             7          LD C,01 ; INITIAL SECTOR NO. is 1 to 14 sector reading
                                ;
       E2E6                     READ_LOOP_WBOOT1:
0000E6 E2E6 CD26E5          17          CALL GO_DMA_AND_READ_WBOOT0
0000E9 E2E9 0C               4          INC C
0000EA E2EA 3A4AEA          13          LD A,(WBOOT_ADDRESS_H) ; memory address of DMA transfer address
0000ED E2ED 3C               4          INC A ; 256 byte incriment
0000EE E2EE 324AEA          13          LD (WBOOT_ADDRESS_H),A
0000F1 E2F1 10F3            13          DJNZ READ_LOOP_WBOOT1
                                
0000F3 E2F3 C3F6E2          10          JP gocpm ; CP/Mを再起動
                                
                                ;==============================================================
                                ; cpm go
                                ;==============================================================
       E2F6                     gocpm:
0000F6 E2F6 3EC3             7          LD  A, 0c3h ;c3 is a jmp instruction
0000F8 E2F8 320000          13          LD  (0),A   ;for jmp to wboot
0000FB E2FB 2103E2          10          LD  HL, wboote  ;wboot entry point
0000FE E2FE 220100          16          LD  (1),HL  ;set address field for jmp at 0
                                ;
000101 E301 320500          13          LD  (5),A   ;for jmp to bdos
000104 E304 2106D4          10          LD  HL, bdos    ;bdos entry point
000107 E307 220600          16          LD  (6),HL  ;address field of Jump at 5 to bdos
                                ;
00010A E30A 018000          10          LD  BC, 80h ;default dma address is 80h
00010D E30D CD70E3          17          CALL    setdma
000110 E310 FB               4          EI  ;enable the interrupt system
000111 E311 3A0400          13          LD  A,(cdisk)   ;get current disk number
000114 E314 4F               4          LD  C, A    ;send to the ccp
000115 E315 C300CC          10          JP  ccp ;go to cp/m for further processing
                                ;
                                ;
                                ;   simple i/o handlers (must be filled in by user)
                                ;   in each case, the entry point is provided, with space reserved
                                ;   to insert your own code
                                ;
       E318                     const:  ;console status, return 0ffh if character ready, 00h if not
000118 E318 3E00             7          LD A,0H ; no character ready
00011A E31A C9              10          RET
                                ;
       E31B                     conin:  ;console character into register a
00011B E31B D5              11          PUSH DE
00011C E31C DDE5            15          PUSH IX
00011E E31E CD1CE7          17          CALL KEY_SCAN_WRAPPER
000121 E321 DDE1            14          POP IX
000123 E323 D1              10          POP DE
000124 E324 C9              10          RET
                                ;
       E325                     conout: ;console character output from register c
000125 E325 F3               4          DI      ;[[[[disable interrupts 20251230]]]]
000126 E326 F5              11          PUSH AF
000127 E327 C5              11          PUSH BC
000128 E328 D5              11          PUSH DE
000129 E329 E5              11          PUSH HL
00012A E32A CD36E6          17          CALL CONOUT_PROCESS
00012D E32D E1              10          POP HL
00012E E32E D1              10          POP DE
00012F E32F C1              10          POP BC
000130 E330 F1              10          POP AF
000131 E331 FB               4          EI      ;[[[[enable interrupts 20251230]]]]
000132 E332 C9              10          RET
                                ;
       E333                     list:   ;list character from register c
000133 E333 79               4          LD  A, C    ;character to register a
000134 E334 C9              10          RET ;null subroutine
                                ;
       E335                     listst: ;return list status (0 if not ready, 1 if ready)
000135 E335 AF               4          XOR A   ;0 is always ok to return
000136 E336 C9              10          RET
                                ;
       E337                     punch:  ;punch  character from  register C
000137 E337 79               4          LD  A, C    ;character to register a
000138 E338 C9              10          RET ;null subroutine
                                ;
                                ;
       E339                     reader: ;reader character into register a from reader device
000139 E339 3E1A             7          LD  A, 1ah  ;enter end of file for now (replace later)
00013B E33B E67F             7          AND 7fh ;remember to strip parity bit
00013D E33D C9              10          RET
                                ;
                                ;
                                ;   i/o drivers for the disk follow
                                ;   for now, we will simply store the parameters away for use
                                ;   in the read and write   subroutines
                                ;
       E33E                     home:   ;move to the track 00   position of current drive
                                ;   translate this call into a settrk call with Parameter 00
00013E E33E 3ABCEA          13          LD  A,(hstwrt)  ;check for pending write
000141 E341 B7               4          OR  A
000142 E342 C248E3          10          JP  NZ,homed
000145 E345 32BBEA          13          LD  (hstact),A  ;clear host active flag
       E348                     homed:
000148 E348 C9              10          RET ;we will move to 00 on first read/write
                                ;
       E349                     seldsk: ;select disk given by register c
000149 E349 210000          10          LD  HL, 0000h   ;error return code
00014C E34C 79               4          LD  A, C
00014D E34D 32B2EA          13          LD  (sekdsk),A
000150 E350 FE04             7          CP  4   ;must be between 0 and 3
000152 E352 D0              11          RET NC  ;no carry if 4, 5,...
                                ;   disk number is in the proper range
                                ;       DS  10  ;space for disk select
                                ;       LD 
                                ;   compute proper disk Parameter header address
000153 E353 3ACEEB          13          LD  A,(diskno)
000156 E356 6F               4          LD  L, A    ;l=disk number 0, 1, 2, 3
000157 E357 2600             7          LD  H, 0    ;high order zero
000159 E359 29              11          ADD HL,HL   ;*2
00015A E35A 29              11          ADD HL,HL   ;*4
00015B E35B 29              11          ADD HL,HL   ;*8
00015C E35C 29              11          ADD HL,HL   ;*16 (size of each header)
00015D E35D 1133E2          10          LD  DE, dpbase ;base of parm block
000160 E360 19              11          ADD HL,DE   ;hl=,dpbase (diskno*16)(curdsk)
000161 E361 C9              10          RET
                                ;
       E362                     settrk:
                                    ;set track given by registers BC
000162 E362 60               4          LD  H,B
000163 E363 69               4          LD  L,C
000164 E364 22B3EA          16          LD  (sektrk),HL ;track to seek
000167 E367 C9              10          RET
                                ;
       E368                     setsec: ;set sector given by register c
000168 E368 79               4          LD  A, C
000169 E369 32B5EA          13          LD  (seksec),A
00016C E36C C9              10          RET
                                ;
                                ;
       E36D                     sectran:
                                    ;translate the sector given by bc using the
                                    ;translate table given by de
                                    ;translate sector number BC
00016D E36D 60               4          LD  H,B
00016E E36E 69               4          LD  L,C
00016F E36F C9              10          RET
                                
                                ;
       E370                     setdma: ;set    dma address given by registers b and c
000170 E370 69               4          LD  L, C    ;low order address
000171 E371 60               4          LD  H, B    ;high order address
000172 E372 22C6EA          16          LD  (dmaadr),HL ;save the address
000175 E375 C9              10          RET
                                
                                ;==============================================================
                                ; The READ entry point takes the place of
                                ; the previous BIOS defintion for READ.
                                ;==============================================================
       E376                     read:   ;perform read operation (usually this is similar to write
                                        ;   so we will allow space to set up read command, then use
                                        ;   common code in write)
                                    ;read the selected CP/M sector
000176 E376 AF               4          XOR A
000177 E377 32BDEA          13          LD  (unacnt),A
00017A E37A 3E01             7          LD  A,1
00017C E37C 32C4EA          13          LD  (readop),A  ;read operation
00017F E37F 32C3EA          13          LD  (rsflag),A  ;must read data
000182 E382 3E02             7          LD  A,wrual
000184 E384 32C5EA          13          LD  (wrtype),A  ;treat as unalloc
000187 E387 C3F5E3          10          JP  rwoper  ;to perform the read
                                
                                ;==============================================================
                                ; The WRITE entry point takes the place of
                                ; the previous BIOS defintion for WRITE.
                                ;==============================================================
       E38A                     write:
                                    ;write the selected CP/M sector
00018A E38A AF               4          XOR A   ;0 to accumulator
00018B E38B 32C4EA          13          LD  (readop),A  ;not a read operation
00018E E38E 79               4          LD  A,C ;write type in c
00018F E38F 32C5EA          13          LD  (wrtype),A
000192 E392 FE02             7          CP  wrual   ;write unallocated?
000194 E394 C2AEE3          10          JP  NZ,chkuna   ;check for unalloc
                                ;
                                ;   write to unallocated, set parameters
000197 E397 3E10             7          LD  A,blksiz/128    ;next unalloc recs
000199 E399 32BDEA          13          LD  (unacnt),A
00019C E39C 3AB2EA          13          LD  A,(sekdsk)  ;disk to seek
00019F E39F 32BEEA          13          LD  (unadsk),A  ;unadsk = sekdsk
0001A2 E3A2 2AB3EA          16          LD  HL,(sektrk)
0001A5 E3A5 22BFEA          16          LD  (unatrk),HL ;unatrk = sectrk
0001A8 E3A8 3AB5EA          13          LD  A,(seksec)
0001AB E3AB 32C1EA          13          LD  (unasec),A  ;unasec = seksec
                                ;
       E3AE                     chkuna:
                                    ;check for write to unallocated sector
0001AE E3AE 3ABDEA          13          LD  A,(unacnt)  ;any unalloc remain?
0001B1 E3B1 B7               4          OR  A
0001B2 E3B2 CAEDE3          10          JP  Z,alloc ;skip if not
                                ;
                                ;   more unallocated records remain
0001B5 E3B5 3D               4          DEC A   ;unacnt = unacnt-1
0001B6 E3B6 32BDEA          13          LD  (unacnt),A
0001B9 E3B9 3AB2EA          13          LD  A,(sekdsk)  ;same disk?
0001BC E3BC 21BEEA          10          LD  HL,unadsk
0001BF E3BF BE               7          CP  (HL)    ;sekdsk = unadsk?
0001C0 E3C0 C2EDE3          10          JP  NZ,alloc    ;skip if not
                                ;
                                ;   disks are the same
0001C3 E3C3 21BFEA          10          LD  HL,unatrk
0001C6 E3C6 CD90E4          17          CALL    sektrkcmp   ;sektrk = unatrk?
0001C9 E3C9 C2EDE3          10          JP  NZ,alloc    ;skip if not
                                ;
                                ;   tracks are the same
0001CC E3CC 3AB5EA          13          LD  A,(seksec)  ;same sector?
0001CF E3CF 21C1EA          10          LD  HL,unasec
0001D2 E3D2 BE               7          CP  (HL)    ;seksec = unasec?
0001D3 E3D3 C2EDE3          10          JP  NZ,alloc    ;skip if not
                                ;
                                ;   match, move to next sector for future ref
0001D6 E3D6 34              11          INC (HL)    ;unasec = unasec+1
0001D7 E3D7 7E               7          LD  A,(HL)  ;end of track?
0001D8 E3D8 FE20             7          CP  cpmspt  ;count CP/M sectors
0001DA E3DA DAE6E3          10          JP  C,noovf ;skip if no overflow
                                ;
                                ;   overflow to next track
0001DD E3DD 3600            10          LD  (HL),0  ;unasec = 0
0001DF E3DF 2ABFEA          16          LD  HL,(unatrk)
0001E2 E3E2 23               6          INC HL
0001E3 E3E3 22BFEA          16          LD  (unatrk),HL ;unatrk = unatrk+1
                                ;
       E3E6                     noovf:
                                    ;match found, mark as unnecessary read
0001E6 E3E6 AF               4          XOR A   ;0 to accumulator
0001E7 E3E7 32C3EA          13          LD  (rsflag),A  ;rsflag = 0
0001EA E3EA C3F5E3          10          JP  rwoper  ;to perform the write
                                ;
       E3ED                     alloc:
                                    ;not an unallocated record, requires pre-read
0001ED E3ED AF               4          XOR A   ;0 to accum
0001EE E3EE 32BDEA          13          LD  (unacnt),A  ;unacnt = 0
0001F1 E3F1 3C               4          INC A   ;1 to accum
0001F2 E3F2 32C3EA          13          LD  (rsflag),A  ;rsflag = 1
                                
                                ;==============================================================
                                ; Common code for READ and WRITE follows
                                ; Modified Interrupt Handling 20251230 by tsunozemi
                                ;==============================================================
       E3F5                     rwoper:
                                    ;enter here to perform the read/write
0001F5 E3F5 AF               4          XOR A   ;zero to accum
0001F6 E3F6 32C2EA          13          LD  (erflag),A  ;no errors (yet)
0001F9 E3F9 3AB5EA          13          LD  A,(seksec)  ;compute host sector
0001FC E3FC B7               4          OR  A   ;carry = 0
0001FD E3FD 1F               4          RRA     ;shift right
0001FE E3FE 32BAEA          13          LD  (sekhst),A  ;host sector to seek ; sekhst = seksec/2
                                ;
                                ;   active host sector?
000201 E401 21BBEA          10          LD  HL,hstact   ;host active flag
000204 E404 7E               7          LD  A,(HL)
000205 E405 3601            10          LD  (HL),1  ;always becomes 1
000207 E407 B7               4          OR  A       ;was it already?
000208 E408 CA2FE4          10          JP  Z,filhst    ;fill host if not
                                ;
                                ;   host buffer active, same as seek buffer?
00020B E40B 3AB2EA          13          LD  A,(sekdsk)
00020E E40E 21B6EA          10          LD  HL,hstdsk   ;same disk?
000211 E411 BE               7          CP  (HL)        ;sekdsk = hstdsk?
000212 E412 C228E4          10          JP  NZ,nomatch
                                ;
                                ;   same disk, same track?
000215 E415 21B7EA          10          LD  HL,hsttrk
000218 E418 CD90E4          17          CALL sektrkcmp  ;sektrk = hsttrk?
00021B E41B C228E4          10          JP  NZ,nomatch
                                ;
                                ;   same disk, same track, same buffer?
00021E E41E 3ABAEA          13          LD  A,(sekhst)
000221 E421 21B9EA          10          LD  HL,hstsec   ;sekhst = hstsec?
000224 E424 BE               7          CP  (HL)
000225 E425 CA4CE4          10          JP  Z,match ;skip if match
                                ;
       E428                     nomatch:
                                    ;proper disk, but not correct sector
000228 E428 3ABCEA          13          LD  A,(hstwrt)      ;host written?
00022B E42B B7               4          OR  A
00022C E42C C49CE4          17          CALL NZ,writehst    ;clear host buff
                                ;
       E42F                     filhst:
                                    ;may have to fill the host buffer
00022F E42F 3AB2EA          13          LD  A,(sekdsk)
000232 E432 32B6EA          13          LD  (hstdsk),A
000235 E435 2AB3EA          16          LD  HL,(sektrk)
000238 E438 22B7EA          16          LD  (hsttrk),HL
00023B E43B 3ABAEA          13          LD  A,(sekhst) ; sekhst -> hstsec
00023E E43E 32B9EA          13          LD  (hstsec),A
000241 E441 3AC3EA          13          LD  A,(rsflag)  ;need to read?
000244 E444 B7               4          OR  A
000245 E445 C4B2E4          17          CALL NZ,readhst ;yes, if 1
000248 E448 AF               4          XOR A           ;0 to accum
000249 E449 32BCEA          13          LD  (hstwrt),A  ;no pending write
                                ;
       E44C                     match:
                                    ;copy data to or from buffer
00024C E44C 3AB5EA          13          LD  A,(seksec)  ;mask buffer number
00024F E44F E601             7          AND secmsk      ;least signif bits
000251 E451 6F               4          LD  L,A         ;ready to shift
000252 E452 2600             7          LD  H,0         ;double count
000254 E454 29              11          ADD HL,HL
000255 E455 29              11          ADD HL,HL
000256 E456 29              11          ADD HL,HL
000257 E457 29              11          ADD HL,HL
000258 E458 29              11          ADD HL,HL
000259 E459 29              11          ADD HL,HL
00025A E45A 29              11          ADD HL,HL
                                ;   hl has relative host buffer address
00025B E45B 11C8EA          10          LD  DE,hstbuf
00025E E45E 19              11          ADD HL,DE       ;hl = host address
00025F E45F EB               4          EX  DE,HL       ;now in DE
000260 E460 2AC6EA          16          LD  HL,(dmaadr) ;get/put CP/M data
000263 E463 0E80             7          LD  C,80H       ;length of move
000265 E465 3AC4EA          13          LD  A,(readop)  ;which way?
000268 E468 B7               4          OR  A
000269 E469 C272E4          10          JP  NZ,rwmove   ;skip if read
                                ;
                                ;   write operation, mark and switch direction
00026C E46C 3E01             7          LD  A,1
00026E E46E 32BCEA          13          LD  (hstwrt),A  ;hstwrt = 1
000271 E471 EB               4          EX  DE,HL   ;source/dest swap
                                ;
       E472                     rwmove:
                                    ;C initially 128(80H), DE is source, HL is dest
000272 E472 1A               7          LD  A,(DE)  ;source character
000273 E473 13               6          INC DE
000274 E474 77               7          LD  (HL),A  ;to dest
000275 E475 23               6          INC HL
000276 E476 0D               4          DEC C       ;loop 128 times
000277 E477 C272E4          10          JP  NZ,rwmove
                                ;
                                ;   data has been moved to/from host buffer
00027A E47A 3AC5EA          13          LD  A,(wrtype)  ;write type
00027D E47D FE01             7          CP  wrdir       ;to directory?
00027F E47F 3AC2EA          13          LD  A,(erflag)  ;in case of errors
000282 E482 C0              11          RET NZ          ;no further processing
                                ;
                                ;   clear host buffer for directory write
000283 E483 B7               4          OR  A   ;errors?
000284 E484 C0              11          RET NZ  ;skip if so
000285 E485 AF               4          XOR A   ;0 to accum
000286 E486 32BCEA          13          LD  (hstwrt),A  ;buffer written
000289 E489 CD9CE4          17          CALL    writehst
00028C E48C 3AC2EA          13          LD  A,(erflag)
00028F E48F C9              10          RET
                                
                                ;==============================================================
                                ; Utility subroutine for 16-bit compare
                                ;==============================================================
       E490                     sektrkcmp:
                                    ;HL = .unatrk or .hsttrk, compare with sektrk
000290 E490 EB               4          EX  DE,HL
000291 E491 21B3EA          10          LD  HL,sektrk
000294 E494 1A               7          LD  A,(DE)  ;low byte compare
000295 E495 BE               7          CP  (HL)    ;same?
000296 E496 C0              11          RET NZ  ;return if not
                                ;   low bytes equal, test high 1s
000297 E497 13               6          INC DE
000298 E498 23               6          INC HL
000299 E499 1A               7          LD  A,(DE)
00029A E49A BE               7          CP  (HL)    ;sets flags
00029B E49B C9              10          RET
                                
                                ;==============================================================
                                ; WRITEHST performs the physical write to
                                ;   the host disk, READHST reads the physical
                                ;   disk.
                                ;==============================================================
       E49C                     writehst:
                                    ;hstdsk = host disk #, hsttrk = host track #,
                                    ;hstsec = host sect #. write "hstsiz" bytes
                                    ;from hstbuf and return error flag in erflag.
                                    ;return erflag non-zero if error
                                
00029C E49C F3               4          DI      ;[[[[disable interrupts 20251230]]]]
                                
00029D E49D 3AB7EA          13          LD A,(hsttrk)
0002A0 E4A0 5F               4          LD E,A ; E is Track No.
0002A1 E4A1 CDE4E4          17          CALL SEEK
0002A4 E4A4 3AB9EA          13          LD A,(hstsec)
0002A7 E4A7 C601             7          ADD A,01H
0002A9 E4A9 4F               4          LD C,A ; C is Sector No.
0002AA E4AA CD15E5          17          CALL GO_DMA_AND_WRITE0
0002AD E4AD 32C2EA          13          LD (erflag),A
                                
0002B0 E4B0 FB               4          EI      ;[[[[enable interrupts 20251230]]]]
                                
0002B1 E4B1 C9              10          RET
                                ;
       E4B2                     readhst:
                                    ;hstdsk = host disk #, hsttrk = host track #,
                                    ;hstsec = host sect #. read "hstsiz" bytes
                                    ;into hstbuf and return error flag in erflag.
                                
0002B2 E4B2 F3               4          DI      ;[[[[disable interrupts 20251230]]]]
                                
0002B3 E4B3 3AB7EA          13          LD A,(hsttrk)
0002B6 E4B6 5F               4          LD E,A ; E is Track No.
0002B7 E4B7 CDE4E4          17          CALL SEEK
0002BA E4BA 3AB9EA          13          LD A,(hstsec)
0002BD E4BD C601             7          ADD A,01H
0002BF E4BF 4F               4          LD C,A ; C is Sector No.
0002C0 E4C0 CDFAE4          17          CALL GO_DMA_AND_READ0
0002C3 E4C3 32C2EA          13          LD (erflag),A
                                
0002C6 E4C6 FB               4          EI      ;[[[[enable interrupts 20251230]]]]
                                
0002C7 E4C7 C9              10          RET
                                ;
                                ; FDC COMMAND OUT subroutine
                                ;
       E4C8                     FDCOUT:
0002C8 E4C8 D3C0            11      OUT (FDC_COMMAND_REG),A
0002CA E4CA 3E30             7      LD A,30H
0002CC E4CC 3D               4  WLOOP: DEC A
0002CD E4CD 20FD            12      JR NZ,WLOOP
       E4CF                     LOOP2:
0002CF E4CF DBC0            11      IN A,(FDC_STATUS_REG)
0002D1 E4D1 CB47             8      BIT 0H,A ; BUSY IS CLEAR?
0002D3 E4D3 20FA            12      JR NZ,LOOP2
0002D5 E4D5 C9              10      RET
                                ;
                                ; RESTORE subroutine
                                ;
       E4D6                     RESTORE:
       E4D6                     RESTORE_LOOP:
0002D6 E4D6 3E0B             7      LD A,0BH ; restore command. 15ms, Head load, Verify OFF
0002D8 E4D8 CDC8E4          17      CALL FDCOUT
0002DB E4DB CB7F             8      BIT 7,A ; Not Ready?
0002DD E4DD 20F7            12      JR NZ,RESTORE_LOOP
0002DF E4DF E698             7      AND 98H
0002E1 E4E1 20F3            12      JR NZ,RESTORE
0002E3 E4E3 C9              10      RET
                                ;
                                ; SEEK subroutine
                                ; E is Track No.
                                ;
       E4E4                     SEEK:
0002E4 E4E4 7B               4      LD A,E ; E is Track No.
0002E5 E4E5 D3C3            11      OUT (FDC_DATA_REG),A
0002E7 E4E7 3E1B             7      LD A,1BH  ; seek command. 15ms, Head Load, Verify OFF
0002E9 E4E9 CDC8E4          17      CALL FDCOUT
0002EC E4EC E698             7      AND 98H
0002EE E4EE C9              10      RET
                                ;
                                ; DMA setting & Go
                                ; HL is Address of DMA Command chain
                                ;       but top value is No of DMA Command chain
       E4EF                     DMA_ON:
0002EF E4EF E5              11      PUSH HL
0002F0 E4F0 C5              11      PUSH BC
0002F1 E4F1 46               7      LD B,(HL)
0002F2 E4F2 23               6      INC HL
0002F3 E4F3 0EC4             7      LD C,DMA_ADDRESS
0002F5 E4F5 EDB3                    OTIR
0002F7 E4F7 C1              10      POP BC
0002F8 E4F8 E1              10      POP HL
0002F9 E4F9 C9              10      RET
                                ;
                                ; DMA setting & FDD read FOR SIDE 0
                                ; C is Sector No.
                                ;
       E4FA                     GO_DMA_AND_READ0:
0002FA E4FA 79               4      LD A,C
0002FB E4FB D3C2            11      OUT (FDC_SECTOR_REG),A
       E4FD                     READ0_RETRY:
0002FD E4FD 210BEA          10      LD HL,DMA_COMMANDS
000300 E500 CDEFE4          17      CALL DMA_ON
000303 E503 3E80             7      LD A,80H ; READ DATA COMMAND for Side 0
       E505                     DO_FDC0:
000305 E505 CDC8E4          17      CALL FDCOUT
                                
000308 E508 F5              11      PUSH AF
000309 E509 3E83             7      LD A,83H
00030B E50B D3C4            11      OUT (DMA_ADDRESS),A
00030D E50D F1              10      POP AF
                                
00030E E50E E63C             7      AND 03CH
000310 E510 2802            12      JR Z, READ0_SUCCESS
000312 E512 18E9            12      JR READ0_RETRY
       E514                     READ0_SUCCESS:
000314 E514 C9              10      RET
                                ;
                                ; DMA setting & FDD write FOR SIDE 0
                                ; C is Sector No.
                                ;
       E515                     GO_DMA_AND_WRITE0:
000315 E515 79               4      LD A,C
000316 E516 D3C2            11      OUT (FDC_SECTOR_REG),A
000318 E518 2121EA          10      LD HL,DMA_WRITE_COMMANDS
00031B E51B CDEFE4          17      CALL DMA_ON
00031E E51E 3EA0             7      LD A,0A0H ; WRITE DATA COMMAND for Side 0
       E520                     DO_FDC_WR0:
000320 E520 CDC8E4          17      CALL FDCOUT
000323 E523 E6FC             7      AND 0FCH
000325 E525 C9              10      RET
                                ;
                                ; DMA setting & FDD read FOR WBOOT at SIDE 0
                                ; C is Sector No.
                                ;
       E526                     GO_DMA_AND_READ_WBOOT0:
000326 E526 79               4      LD A,C
000327 E527 D3C2            11      OUT (FDC_SECTOR_REG),A
000329 E529 2138EA          10      LD HL,DMA_WBOOT_COMMANDS
00032C E52C CDEFE4          17      CALL DMA_ON
00032F E52F 3E80             7      LD A,80H ; READ DATA COMMAND for Side 0
000331 E531 CDC8E4          17      CALL FDCOUT
000334 E534 E63C             7      AND 03CH
000336 E536 C9              10      RET
                                
                                
                                ;==============================================================
                                ; SORD M23用CRTコントロールドライバ、キーボードドライバ
                                ;==============================================================
                                
                                ;==============================================================
                                ; FDC 初期化ルーチン
                                ;==============================================================
       E537                     FDC_INIT:
000337 E537 3E51             7      LD A,51H
000339 E539 32C500          13      LD (FDC_CONTROL_REG),A
00033C E53C C9              10      RET
                                
                                ;==============================================================
                                ; キーボード初期化ルーチン
                                ;==============================================================
       E53D                     KBD_INIT:
                                ;
                                ; キーボードスキャンバッファーを0で埋める。必要ないかも。
                                ;
00033D E53D 2100EE          10      LD HL,KEYBOARD_SCAN_BUFFER
000340 E540 011000          10      LD BC,10H
000343 E543 3E00             7      LD A,0H
000345 E545 77               7      LD (HL),A
000346 E546 54               4      LD D,H
000347 E547 5D               4      LD E,L
000348 E548 13               6      INC DE
000349 E549 0B               6      DEC BC
00034A E54A 78               4      LD A,B
00034B E54B B1               4      OR C
00034C E54C C8              11      RET Z
00034D E54D EDB0                    LDIR
00034F E54F C9              10      RET
                                
                                ;==============================================================
                                ; CRT 初期化ルーチン
                                ;==============================================================;
       E550                     CRT_INIT:
000350 E550 2100F0          10      LD HL,0F000H ; VRAMの左上のアトリビュートアドレス
000353 E553 010008          10      LD BC,0800H
                                
                                ; カーソル座標を00Hに設定する。
                                ; 注：画面左上がカーソル座標では0000Hになる。VRAMにおけるテキスト画面左上(F800H)ではないことに注意。
000356 E556 3E0E             7      LD A,0EH ; R14 (cursor H)
000358 E558 D3F0            11      OUT (CRTC_ADDRESS_PORT),A
00035A E55A 3E00             7      LD A,0H
00035C E55C D3F1            11      OUT (CRTC_VALUE_PORT),A
00035E E55E 3E0F             7      LD A,0FH ; R15 (cursor L)
000360 E560 D3F0            11      OUT (CRTC_ADDRESS_PORT),A
000362 E562 3E00             7      LD A,00H
000364 E564 D3F1            11      OUT (CRTC_VALUE_PORT),A
                                
                                ; カーソルの形状と点滅の設定
000366 E566 3E0A             7      LD A,0AH ; R10 (cursol start address)
000368 E568 D3F0            11      OUT (CRTC_ADDRESS_PORT),A
                                ;   LD A,C0H ; 点滅、豆腐カーソル
00036A E56A 3EC7             7      LD A,C7H ; 点滅、アンスコカーソル
                                ;   LD A,0H ; 表示せず。
00036C E56C D3F1            11      OUT (CRTC_VALUE_PORT),A
00036E E56E 3E0B             7      LD A,0BH ; R11 (cursol end address)
000370 E570 D3F0            11      OUT (CRTC_ADDRESS_PORT),A
000372 E572 3E0A             7      LD A,0AH
                                ;   LD A,0H ; 表示せず。
000374 E574 D3F1            11      OUT (CRTC_VALUE_PORT),A
                                
                                ;
                                ;   一度画面全てを消す(スペースで埋める)。
                                ;
000376 E576 0650             7      LD B,050H
000378 E578 11FFFF          10      LD DE,0FFFFH
00037B E57B 3E20             7      LD A,20H ; 20Hはアスキーコードでスペース
       E57D                     CLEAR_ALL_LINE:
00037D E57D D3D2            11      OUT (0D2H),A ; D2Hポートになにか書くと次の命令は別のページ(この場合はVRAMのページ)に行う。
00037F E57F 77               7      LD (HL),A ; F000H～FFFFHまで20Hで埋めている。アトリビュートに20H書いても問題ないみたい。
000380 E580 23               6      INC HL
000381 E581 ED52            15      SBC HL,DE
000383 E583 20F8            12      JR NZ,CLEAR_ALL_LINE
                                
000385 E585 AF               4      XOR A ; コントロールコードの処理が行われたことを示すフラグをリセットする
000386 E586 326FEA          13      LD (CURSOR_X),A ; カーソルのX座標を0にする
000389 E589 3270EA          13      LD (CURSOR_Y),A ; カーソルのY座標を0にする
                                
00038C E58C C9              10      RET ; 初期化処理終了
                                
                                
                                ;==============================================================
                                ; SORD M23 CP/M ディスプレイドライバ
                                ; CPU:  Z80
                                ; CRTC: HD46505 (MC6845)
                                ; テキストモード: 80桁 × 25行
                                ;==============================================================
                                ;
                                ; [提供サブルーチン一覧]
                                ;
                                ;   GET_VRAM_ADDRESS_FROM_X_Y  … (X,Y) → VRAM アドレス
                                ;   GET_X_Y_FROM_VRAM_ADDRESS  … VRAM アドレス → (X,Y)
                                ;   SCROLL_UP                  … 画面を 1行上スクロール
                                ;   WRITE_CHAR_AT_XY           … (X,Y) の位置に 1文字書き込む
                                ;
                                ;==============================================================
                                
                                
                                ;--------------------------------------------------------------
                                ; 定数 ― I/O ポート
                                ;--------------------------------------------------------------
       00D2                     VRAM_BANK_PORT      EQU 0D2H    ; VRAMバンク切替ポート
                                                                ;   → このポートに書くと【次の1命令】が
                                                                ;     VRAM ページへのアクセスになる
                                
                                ;--------------------------------------------------------------
                                ; 定数 ― HD46505 レジスタ番号
                                ;--------------------------------------------------------------
       000C                     CRTC_R12_START_H    EQU 0CH     ; Start Address High  (画面先頭アドレス上位)
       000D                     CRTC_R13_START_L    EQU 0DH     ; Start Address Low   (画面先頭アドレス下位)
       000E                     CRTC_R14_CURSOR_H   EQU 0EH     ; Cursor Address High
       000F                     CRTC_R15_CURSOR_L   EQU 0FH     ; Cursor Address Low
                                
                                ;--------------------------------------------------------------
                                ; データ領域
                                ;--------------------------------------------------------------
                                
                                ;------------------------------------------------------------
                                ; CURRENT_TOP_LEFT_ADDRESS  (2 バイト)
                                ;
                                ; 現在の画面左上端の VRAM 絶対アドレス。
                                ; 初期値 = F800H。
                                ; スクロールのたびに +80 進み、FFFFH を超えると
                                ; 旧コードの算法で F800H 付近へ折り返す。
                                ;
                                ; TLA は常に 16 の倍数のオフセットを持つ:
                                ;   F800H, F810H, F820H, ..., FFFOH の 128 種類が循環する。
                                ;   (GCD(80, 2048) = 16 より)
                                ;------------------------------------------------------------
       E58D                     CURRENT_TOP_LEFT_ADDRESS:
00038D E58D 00F8                    DW  VRAM_TXT_TOP        ; 初期値: F800H
                                
                                
                                ;==============================================================
                                ; GET_VRAM_ADDRESS_FROM_X_Y
                                ;
                                ; 仮想座標 (X, Y) から VRAM アドレスを計算する。
                                ; VRAM リング (F800H-FFFFH = 2048 バイト) の折り返しを考慮。
                                ;
                                ; 入力:  B = Y 論理行 (0-24)   C = X 論理列 (0-79)
                                ; 出力:  HL = VRAM アドレス
                                ; 破壊:  A, DE
                                ;
                                ; 計算式:
                                ;   offset  = Y × 80 + X              [0 ～ 1999]
                                ;   raw     = TLA + offset             [16 ビット加算]
                                ;
                                ;   キャリーなし: VRAM = raw           (raw ∈ F800H..FFFFH)
                                ;   キャリーあり: VRAM = raw + F800H   (raw = TLA+offset-10000H を
                                ;                                       VRAM_TXT_TOP で補正)
                                ;
                                ; [Y × 80 の計算]
                                ;   80 = 64 + 16 = 2^6 + 2^4
                                ;   Y × 80 = Y×64 + Y×16
                                ;   中間値 Y×16 を DE に保存し、Y×64 後に加算する。
                                ;==============================================================
       E58F                     GET_VRAM_ADDRESS_FROM_X_Y:
                                
                                    ;----------------------------------------------------------
                                    ; ① Y × 80 (シフト + 加算)
                                    ;----------------------------------------------------------
00038F E58F 2600             7      LD  H, 0
000391 E591 68               4      LD  L, B            ; HL = Y
000392 E592 29              11      ADD HL, HL          ; HL = 2Y
000393 E593 29              11      ADD HL, HL          ; HL = 4Y
000394 E594 29              11      ADD HL, HL          ; HL = 8Y
000395 E595 29              11      ADD HL, HL          ; HL = 16Y
000396 E596 54               4      LD  D, H
000397 E597 5D               4      LD  E, L            ; DE = 16Y を保存
000398 E598 29              11      ADD HL, HL          ; HL = 32Y
000399 E599 29              11      ADD HL, HL          ; HL = 64Y
00039A E59A 19              11      ADD HL, DE          ; HL = 64Y + 16Y = 80Y
                                
                                    ;----------------------------------------------------------
                                    ; ② X を加算 → offset (0 ～ 1999)
                                    ;----------------------------------------------------------
00039B E59B 1600             7      LD  D, 0
00039D E59D 59               4      LD  E, C
00039E E59E 19              11      ADD HL, DE          ; HL = Y×80 + X
                                
                                    ;----------------------------------------------------------
                                    ; ③ CURRENT_TOP_LEFT_ADDRESS (TLA) を加算
                                    ;----------------------------------------------------------
00039F E59F ED5B8DE5        20      LD  DE, (CURRENT_TOP_LEFT_ADDRESS)
0003A3 E5A3 19              11      ADD HL, DE          ; HL = TLA + offset  [16 ビット加算]
                                
                                    ;----------------------------------------------------------
                                    ; ④ VRAM リング折り返し補正
                                    ;
                                    ;   キャリーなし: HL ∈ [F800H, FFFFH] → そのまま返す
                                    ;   キャリーあり: HL = TLA + offset - 10000H  (∈ [0000H, ~07CEH])
                                    ;                 正しい VRAM = HL + F800H
                                    ;
                                    ;   例: TLA=F850H, Y=24, X=0 → offset=1920
                                    ;     F850H + 0780H = FFD0H (キャリーなし) → FFD0H ✓
                                    ;   例: TLA=FF80H, Y=24, X=0 → offset=1920
                                    ;     FF80H + 0780H = 10700H (キャリーあり) → HL=0700H
                                    ;     0700H + F800H = FF00H ✓
                                    ;----------------------------------------------------------
0003A4 E5A4 D0              11      RET NC                      ; キャリーなし → HL は有効 VRAM アドレス
0003A5 E5A5 1100F8          10      LD  DE, VRAM_TXT_TOP        ; F800H
0003A8 E5A8 19              11      ADD HL, DE                  ; HL = (TLA + offset - 10000H) + F800H
0003A9 E5A9 C9              10      RET
                                
                                ;==============================================================
                                ; GET_X_Y_FROM_VRAM_ADDRESS
                                ;
                                ; VRAM アドレスから仮想座標 (X, Y) を逆算する。
                                ; (表示中の有効な VRAM アドレスを入力すること)
                                ;
                                ; 入力:  HL = VRAM アドレス
                                ; 出力:  B = Y 論理行 (0-24)   C = X 論理列 (0-79)
                                ; 破壊:  A, DE, HL
                                ;
                                ; 計算式:
                                ;   CRTC_offset = (VRAM - TLA) mod 2048
                                ;
                                ;   VRAM >= TLA のとき: CRTC_offset = VRAM - TLA
                                ;   VRAM <  TLA のとき: CRTC_offset = VRAM - TLA + 2048
                                ;                                    = (VRAM - TLA + 10000H) - F800H
                                ;
                                ;   Y = CRTC_offset ÷ 80  (繰り返し減算、最大 24 回)
                                ;   X = CRTC_offset mod 80
                                ;
                                ;   例: TLA=F850H, VRAM=FFD0H
                                ;     FFD0H - F850H = 0780H = 1920 (キャリーなし)
                                ;     Y = 24, X = 0 ✓
                                ;   例: TLA=FF80H, VRAM=F800H
                                ;     F800H - FF80H → ボロー → HL=F880H, +2048-補正:
                                ;     F880H - F800H = 0080H = 128 (キャリーあり)
                                ;     Y = 1, X = 48 ✓
                                ;==============================================================
       E5AA                     GET_X_Y_FROM_VRAM_ADDRESS:
                                
                                    ;----------------------------------------------------------
                                    ; ① CRTC_offset = (VRAM - TLA) mod 2048
                                    ;----------------------------------------------------------
0003AA E5AA ED5B8DE5        20      LD  DE, (CURRENT_TOP_LEFT_ADDRESS)
0003AE E5AE AF               4      XOR A                       ; キャリークリア (かつ A=0)
0003AF E5AF ED52            15      SBC HL, DE                  ; HL = VRAM - TLA
                                
0003B1 E5B1 3006            12      JR  NC, GXYVA_OFFSET_OK     ; VRAM >= TLA: HL = CRTC_offset
                                
                                    ; VRAM < TLA (リング折り返し):
                                    ;   HL = VRAM - TLA + 10000H  (∈ F801H..FFFFH)
                                    ;   CRTC_offset = HL - F800H  = VRAM - TLA + 800H
                                    ;
                                    ;   OR A で CY=0 を保証したうえで SBC することで
                                    ;   A の値を変えずに正確に F800H を引く。
0003B3 E5B3 1100F8          10      LD  DE, VRAM_TXT_TOP        ; F800H
0003B6 E5B6 B7               4      OR  A                       ; キャリークリア (A=0 のまま保持)
0003B7 E5B7 ED52            15      SBC HL, DE                  ; HL = (VRAM - TLA + 10000H) - F800H
                                                                ;    = VRAM - TLA + 800H = CRTC_offset
                                
       E5B9                     GXYVA_OFFSET_OK:
                                    ; HL = CRTC_offset  (0 ～ 1999)
                                
                                    ;----------------------------------------------------------
                                    ; ② CRTC_offset ÷ 80 → Y (商),  X (余り)
                                    ;    繰り返し減算: 最大 24 回のループで完了
                                    ;----------------------------------------------------------
0003B9 E5B9 0600             7      LD  B, 0                    ; Y カウンタ
       E5BB                     GXYVA_DIV:
0003BB E5BB 7C               4      LD  A, H
0003BC E5BC B7               4      OR  A
0003BD E5BD 2005            12      JR  NZ, GXYVA_SUB          ; H ≠ 0 → HL ≧ 256 > 80 → まだ引ける
0003BF E5BF 7D               4      LD  A, L
0003C0 E5C0 FE50             7      CP  NUMBER_OF_CHARACTER_AT_LINE               ; L < 80 ?
0003C2 E5C2 380A            12      JR  C,  GXYVA_DONE         ; L < 80 → 除算完了
       E5C4                     GXYVA_SUB:
0003C4 E5C4 7D               4      LD  A, L
0003C5 E5C5 D650             7      SUB NUMBER_OF_CHARACTER_AT_LINE               ; A = L - 80
0003C7 E5C7 6F               4      LD  L, A
0003C8 E5C8 3001            12      JR  NC, GXYVA_INC
0003CA E5CA 25               4      DEC H                       ; ボロー補正
       E5CB                     GXYVA_INC:
0003CB E5CB 04               4      INC B                       ; Y++
0003CC E5CC 18ED            12      JR  GXYVA_DIV
       E5CE                     GXYVA_DONE:
0003CE E5CE 4D               4      LD  C, L                    ; C = X (余り = 論理列)
                                    ; B = Y (商 = 論理行) ← 出力確定
0003CF E5CF C9              10      RET
                                
                                
                                
                                ;==============================================================
                                ; SCROLL_UP
                                ;
                                ; 画面を 1 行上スクロールする。
                                ;
                                ; [処理概要]
                                ;   [1] CURRENT_TOP_LEFT_ADDRESS から 80 文字をスペースで消去
                                ;       (FFFFH → F800H の境界越えを考慮)
                                ;   [2] CURRENT_TOP_LEFT_ADDRESS を 80 進める
                                ;       (境界越え時は旧コードの算法 + -2 補正)
                                ;   [3] HD46505 R12/R13 に新 TLA を書き込む (絶対 VRAM アドレス)
                                ;
                                ; 入力:  なし
                                ; 出力:  なし
                                ; 破壊:  なし (AF, BC, DE, HL をすべて保存・復元)
                                ;
                                ; [TLA 進め方の算法 --- 境界越え時]
                                ;   TLA + 50H > FFFFH のとき、旧コードの算法を用いる:
                                ;     A      = FFFFH - TLA - 1  (CY=1 を受け取って SBC)
                                ;     result = 50H - A - CY2    (CY2 は上記 SBC の繰り越し)
                                ;     new_TLA = VRAM_TXT_TOP + result - 2
                                ;   末尾の -2 はキャリー伝播に起因する算法固有の補正値。
                                ;
                                ;   例: TLA=FFD0H → new_TLA=F820H
                                ;     FFFFH - FFD0H - 1 = 2EH
                                ;     50H - 2EH = 22H
                                ;     F800H + 22H - 2 = F820H ✓  (期待値: (2000+80) mod 2048 = 32 → F820H)
                                ;==============================================================
       E5D0                     SCROLL_UP:
0003D0 E5D0 F5              11      PUSH AF
0003D1 E5D1 C5              11      PUSH BC
0003D2 E5D2 D5              11      PUSH DE
0003D3 E5D3 E5              11      PUSH HL
                                
                                    ;----------------------------------------------------------
                                    ; [1] 旧最上行 (TLA から 80 文字) をスペースで消去
                                    ;
                                    ;     1 文字書くたびに PUSH HL / OR A / SBC HL, FFFFH / POP HL で
                                    ;     HL = FFFFH かどうかを判定する (OR A で CY=0 を保証)。
                                    ;     FFFFH 書き込み後: DJNZ が未実行のため DEC B で補正してから
                                    ;     F800H へ折り返し、残り文字数分を書き続ける。
                                    ;----------------------------------------------------------
0003D4 E5D4 2A8DE5          16      LD  HL, (CURRENT_TOP_LEFT_ADDRESS)
0003D7 E5D7 11FFFF          10      LD  DE, 0FFFFH          ; 境界判定用
0003DA E5DA 0650             7      LD  B, NUMBER_OF_CHARACTER_AT_LINE        ; B = 80 (ループカウンタ)
0003DC E5DC 3E20             7      LD  A, 20H              ; スペース文字
                                
       E5DE                     SU_CLEAR:
0003DE E5DE D3D2            11      OUT (VRAM_BANK_PORT), A ; 次の命令 (LD(HL),A) を VRAM ページへ
0003E0 E5E0 77               7      LD  (HL), A             ; VRAM にスペースを書き込む
0003E1 E5E1 E5              11      PUSH HL
0003E2 E5E2 B7               4      OR  A                   ; キャリークリア (OR A は A=20H を保持, CY=0 保証)
0003E3 E5E3 ED52            15      SBC HL, DE              ; HL - FFFFH: Z=1 のとき HL=FFFFH
0003E5 E5E5 E1              10      POP HL
0003E6 E5E6 2805            12      JR  Z, SU_CLEAR_WRAP    ; FFFFH に達したら折り返し
0003E8 E5E8 23               6      INC HL
       E5E9                     SU_CLEAR_NEXT:
0003E9 E5E9 10F3            13      DJNZ SU_CLEAR           ; B--、B≠0 ならループ
0003EB E5EB 180C            12      JR  SU_CLEAR_DONE
                                
       E5ED                     SU_CLEAR_WRAP:
                                    ; FFFFH への書き込みは完了。この反復では DJNZ を実行していないため
                                    ; B をデクリメントして補正する。
0003ED E5ED 05               4      DEC B
0003EE E5EE 2809            12      JR  Z, SU_CLEAR_DONE    ; B=0 → 80 文字消去完了
0003F0 E5F0 2100F8          10      LD  HL, VRAM_TXT_TOP    ; F800H へ折り返し
       E5F3                     SU_CLEAR_WRAP_LOOP:
0003F3 E5F3 D3D2            11      OUT (VRAM_BANK_PORT), A
0003F5 E5F5 77               7      LD  (HL), A
0003F6 E5F6 23               6      INC HL
0003F7 E5F7 10FA            13      DJNZ SU_CLEAR_WRAP_LOOP
                                
       E5F9                     SU_CLEAR_DONE:
                                
                                    ;----------------------------------------------------------
                                    ; [2] CURRENT_TOP_LEFT_ADDRESS を NUMBER_OF_CHARACTER_AT_LINE (80) 進める
                                    ;----------------------------------------------------------
0003F9 E5F9 2A8DE5          16      LD  HL, (CURRENT_TOP_LEFT_ADDRESS)
0003FC E5FC 115000          10      LD  DE, NUMBER_OF_CHARACTER_AT_LINE           ; 50H = 80
0003FF E5FF 19              11      ADD HL, DE                  ; HL = TLA + 80
000400 E600 3015            12      JR  NC, SU_UPDATE_TLA       ; オーバーフローなし → そのまま
                                
                                    ; TLA + 80 > FFFFH の場合 (CY=1 を保持したまま以降の SBC へ渡す)
000402 E602 11FFFF          10      LD  DE, 0FFFFH
000405 E605 2A8DE5          16      LD  HL, (CURRENT_TOP_LEFT_ADDRESS)  ; TLA を再ロード
000408 E608 EB               4      EX  DE, HL                  ; HL = FFFFH,  DE = TLA
000409 E609 ED52            15      SBC HL, DE                  ; HL = FFFFH - TLA - 1  (CY=1 を使用)
00040B E60B 115000          10      LD  DE, NUMBER_OF_CHARACTER_AT_LINE           ; 50H
00040E E60E EB               4      EX  DE, HL                  ; HL = 50H,  DE = (FFFFH - TLA - 1)
00040F E60F ED52            15      SBC HL, DE                  ; HL = 50H - (FFFFH-TLA-1) - CY
000411 E611 1100F8          10      LD  DE, VRAM_TXT_TOP        ; F800H
000414 E614 19              11      ADD HL, DE
000415 E615 2B               6      DEC HL                      ; -2 補正 (算法固有)
000416 E616 2B               6      DEC HL
                                
       E617                     SU_UPDATE_TLA:
000417 E617 228DE5          16      LD  (CURRENT_TOP_LEFT_ADDRESS), HL
                                
                                    ;----------------------------------------------------------
                                    ; [3] HD46505 R12/R13 に新 TLA を書き込む
                                    ;     H → R12 (上位),  L → R13 (下位)
                                    ;     絶対 VRAM アドレスをそのまま書き込む (旧コードと同方式)
                                    ;----------------------------------------------------------
00041A E61A 3E0C             7      LD  A, CRTC_R12_START_H
00041C E61C D3F0            11      OUT (CRTC_ADDRESS_PORT), A
00041E E61E 7C               4      LD  A, H
00041F E61F D3F1            11      OUT (CRTC_VALUE_PORT), A
                                
000421 E621 3E0D             7      LD  A, CRTC_R13_START_L
000423 E623 D3F0            11      OUT (CRTC_ADDRESS_PORT), A
000425 E625 7D               4      LD  A, L
000426 E626 D3F1            11      OUT (CRTC_VALUE_PORT), A
                                
000428 E628 E1              10      POP HL
000429 E629 D1              10      POP DE
00042A E62A C1              10      POP BC
00042B E62B F1              10      POP AF
00042C E62C C9              10      RET
                                
                                
                                ;==============================================================
                                ; WRITE_CHAR_AT_X_Y
                                ;
                                ; 仮想座標 (X, Y) の位置に 1文字を VRAM へ書き込む。
                                ; カーソル位置は変更しない。
                                ;
                                ; 入力: B = Y 論理行 (0-24)
                                ;       C = X 論理列 (0-79)
                                ;       A = 書き込む文字コード
                                ; 出力:  なし
                                ; 破壊:  A, DE, HL
                                ;         (BC は GET_VRAM_ADDRESS_FROM_X_Y が保存するため変化なし)
                                ;
                                ; 【カーソル表示との連携について】
                                ;   本ルーチンは VRAM への文字書き込みのみ行う。
                                ;   画面上のカーソル位置を更新したい場合は、呼び出し側が
                                ;   CURRENT_CURSOR_LOCATE を更新したうえで PRINT_CURSOR を呼ぶこと。
                                ;==============================================================
       E62D                     WRITE_CHAR_AT_X_Y:
                                    ;----------------------------------------------------------
                                    ; GET_VRAM_ADDRESS_FROM_X_Y は A を破壊するため、
                                    ; 書き込む文字コードを PUSH AF でスタックに退避する。
                                    ; CALL 後に POP AF で復元してから VRAM へ書き込む。
                                    ;----------------------------------------------------------
00042D E62D F5              11      PUSH AF                         ; 文字コード (A) を退避
00042E E62E CD8FE5          17      CALL GET_VRAM_ADDRESS_FROM_X_Y  ; HL = VRAM アドレス  (A, DE 破壊)
000431 E631 F1              10      POP  AF                         ; A = 文字コード を復元
                                
000432 E632 D3D2            11      OUT  (VRAM_BANK_PORT), A        ; 次の命令 (LD(HL),A) を VRAM ページへ
000434 E634 77               7      LD   (HL), A                    ; VRAM に文字を書き込む
000435 E635 C9              10      RET
                                
                                
                                ;==============================================================
                                ; CONOUT_PROCESS  (CP/M BIOS コンソール出力)
                                ;
                                ; CP/M BIOS インターフェース:
                                ;   C = 出力文字コード
                                ;
                                ; 破壊: なし (AF, BC, DE, HL をすべて保存・復元)
                                ;
                                ; 制御コード処理:
                                ;   0AH (LF) : X = 0 (行頭へ)、Y 変化なし
                                ;   0DH (CR) : Y += 1 (次行へ)、X 変化なし
                                ;              Y = 24 (最下行) の場合は SCROLL_UP を呼び Y を 24 に維持
                                ;   20H 未満の他の制御コード : 無視 (カーソル位置更新のみ)
                                ;   20H 以上の印字文字       : 現在位置に書き込み後 X += 1
                                ;              X = 80 (行末超え) の場合: X=0 にして CR 相当の処理
                                ;==============================================================
       E636                     CONOUT_PROCESS:
000436 E636 F5              11      PUSH AF
000437 E637 C5              11      PUSH BC
000438 E638 D5              11      PUSH DE
000439 E639 E5              11      PUSH HL
                                
00043A E63A 79               4      LD  A, C                    ; A = 出力文字コード
                                
                                    ;----------------------------------------------------------
                                    ; 制御コード分岐
                                    ;----------------------------------------------------------
00043B E63B FE07             7      CP  BEL
00043D E63D CADDE6          10      JP  Z, CO_BEL   ; BEL (07H): 無視
000440 E640 FE09             7      CP  HT
000442 E642 CAC3E6          10      JP  Z, CO_HT    ; 水平タブ
000445 E645 FE0A             7      CP  LF
000447 E647 CA84E6          10      JP  Z, CO_LF    ; LF (0AH): X=0、Y 変化なし
00044A E64A FE0B             7      CP  VT
00044C E64C CAD9E6          10      JP  Z, CO_VT    ; 垂直タブ
00044F E64F FE0C             7      CP  FOF
000451 E651 CADBE6          10      JP  Z, CO_FF    ; フォームフィード
000454 E654 FE0D             7      CP  CR
000456 E656 CA8BE6          10      JP  Z, CO_CR    ; CR (0DH): Y+1 (最下行ならスクロール)
000459 E659 FE08             7      CP  BS
00045B E65B CA98E6          10      JP  Z, CO_BS    ; BS (08H): バックスペース
00045E E65E FE20             7      CP  20H
000460 E660 DAE2E6          10      JP  C, CO_CURSOR_UPDATE    ; 00H-19H のその他の制御コード: 無視
                                
                                    ;----------------------------------------------------------
                                    ; 印字可能文字 (20H 以上)
                                    ;
                                    ; WRITE_CHAR_AT_X_Y は A, DE, HL を破壊するため
                                    ; 文字コードを D に退避してから呼ぶ
                                    ;----------------------------------------------------------
000463 E663 57               4      LD  D, A                    ; D = 文字コードを退避
000464 E664 3A70EA          13      LD  A, (CURSOR_Y)
000467 E667 47               4      LD  B, A                    ; B = Y
000468 E668 3A6FEA          13      LD  A, (CURSOR_X)
00046B E66B 4F               4      LD  C, A                    ; C = X
00046C E66C 7A               4      LD  A, D                    ; A = 文字コードを復元
00046D E66D CD2DE6          17      CALL WRITE_CHAR_AT_X_Y      ; (X,Y) の位置に文字を書き込む
                                
                                    ; X を進める
000470 E670 3A6FEA          13      LD  A, (CURSOR_X)
000473 E673 3C               4      INC A
000474 E674 FE50             7      CP  80                      ; X = 80 (行末超え)?
000476 E676 3806            12      JR  C, CO_SAVE_X            ; X < 80: そのまま保存してカーソル更新へ
                                    ; 行末折り返し: X=0 にして CR 相当の処理 (Y+1 またはスクロール) へ
000478 E678 AF               4      XOR A
000479 E679 326FEA          13      LD  (CURSOR_X), A
00047C E67C 180D            12      JR  CO_CR
                                
       E67E                     CO_SAVE_X:
00047E E67E 326FEA          13      LD  (CURSOR_X), A
000481 E681 C3E2E6          10      JP  CO_CURSOR_UPDATE
                                
                                    ;----------------------------------------------------------
                                    ; LF (0AH): X = 0、Y 変化なし
                                    ;----------------------------------------------------------
       E684                     CO_LF:
000484 E684 AF               4      XOR A
000485 E685 326FEA          13      LD  (CURSOR_X), A
000488 E688 C3E2E6          10      JP  CO_CURSOR_UPDATE
                                
                                    ;----------------------------------------------------------
                                    ; CR (0DH): Y += 1、X 変化なし
                                    ; ※ 行末折り返し (X=80) のときもここに合流する
                                    ;----------------------------------------------------------
       E68B                     CO_CR:
00048B E68B 3A70EA          13      LD  A, (CURSOR_Y)
00048E E68E FE18             7      CP  24                      ; 最下行 (Y=24)?
000490 E690 284D            12      JR  Z, CO_SCROLL            ; Yes → スクロール (Y は 24 のまま)
000492 E692 3C               4      INC A
000493 E693 3270EA          13      LD  (CURSOR_Y), A
000496 E696 184A            12      JR  CO_CURSOR_UPDATE
                                
                                ;----------------------------------------------------------
                                    ; CO_BS  バックスペース (08H)
                                    ;
                                    ; カーソルを 1 つ戻し、その位置をスペースで消去する。
                                    ;
                                    ; 処理:
                                    ;   X > 0          : X -= 1
                                    ;   X = 0, Y > 0   : X = 79, Y -= 1  (前行末へ折り返し)
                                    ;   X = 0, Y = 0   : 何もしない (画面左上端、戻れない)
                                    ;----------------------------------------------------------
       E698                     CO_BS:
000498 E698 3A6FEA          13      LD  A, (CURSOR_X)
00049B E69B B7               4      OR  A                       ; X = 0?
00049C E69C 2011            12      JR  NZ, CO_BS_DEC_X        ; No → X を 1 減らすだけ
                                
                                    ; X = 0 のとき
00049E E69E 3A70EA          13      LD  A, (CURSOR_Y)
0004A1 E6A1 B7               4      OR  A                       ; Y = 0?
0004A2 E6A2 281C            12      JR  Z, CO_BS_IGNORE        ; Yes → 左上端、何もしない
                                
                                    ; X=0, Y>0: 前行末 (X=79, Y-1) へ
0004A4 E6A4 3D               4      DEC A
0004A5 E6A5 3270EA          13      LD  (CURSOR_Y), A           ; Y -= 1
0004A8 E6A8 3E4F             7      LD  A, 79
0004AA E6AA 326FEA          13      LD  (CURSOR_X), A           ; X = 79
0004AD E6AD 1804            12      JR  CO_BS_ERASE
                                
       E6AF                     CO_BS_DEC_X:
0004AF E6AF 3D               4      DEC A
0004B0 E6B0 326FEA          13      LD  (CURSOR_X), A           ; X -= 1
                                
                                    ;----------------------------------------------------------
                                    ; 戻った位置をスペース (20H) で消去
                                    ; 参考コードの OUT(D2H)+LD(DE),A に相当する処理を
                                    ; WRITE_CHAR_AT_X_Y 経由で行う
                                    ;----------------------------------------------------------
       E6B3                     CO_BS_ERASE:
0004B3 E6B3 3A70EA          13      LD  A, (CURSOR_Y)
0004B6 E6B6 47               4      LD  B, A                    ; B = Y
0004B7 E6B7 3A6FEA          13      LD  A, (CURSOR_X)
0004BA E6BA 4F               4      LD  C, A                    ; C = X
0004BB E6BB 3E20             7      LD  A, 20H                  ; A = スペース
0004BD E6BD CD2DE6          17      CALL WRITE_CHAR_AT_X_Y      ; (X,Y) の位置をスペースで消去
                                
       E6C0                     CO_BS_IGNORE:
0004C0 E6C0 C3E2E6          10      JP  CO_CURSOR_UPDATE        ; CONOUT の CO_CURSOR_UPDATE ラベルへ
                                
                                ;----------------------------------------------------------
                                    ; CO_HT  水平タブ (09H)  タブ幅 4
                                    ;
                                    ; 次の 4 の倍数列へ X を進める。
                                    ;
                                    ; タブストップ: X = 0, 4, 8, 12, ... , 76
                                    ;
                                    ; 計算式:
                                    ;   new_X = (CURSOR_X & FCH) + 4
                                    ;   ※ AND FCH で下 2 ビットをクリア(4 の倍数へ切り捨て)
                                    ;     → そこに 4 を加えて次のタブストップを得る
                                    ;
                                    ;   例: X=0  → (00H & FCH)+4 = 04H
                                    ;       X=3  → (00H & FCH)+4 = 04H
                                    ;       X=4  → (04H & FCH)+4 = 08H
                                    ;       X=77 → (4CH & FCH)+4 = 50H=80 → 行末超え → X=0 かつ CO_CR へ
                                    ;----------------------------------------------------------
       E6C3                     CO_HT:
0004C3 E6C3 3A6FEA          13      LD  A, (CURSOR_X)
0004C6 E6C6 E6FC             7      AND 0FCH                    ; X を 4 の倍数に切り捨て
0004C8 E6C8 C604             7      ADD A, 4                    ; 次のタブストップ (4..80)
0004CA E6CA FE50             7      CP  80                      ; 80 以上 (行末超え)?
0004CC E6CC 3806            12      JR  C, CO_HT_SAVE           ; No → そのまま保存してカーソル更新へ
                                    ; 行末超え: X=0 にして CR 相当 (Y+1 またはスクロール) へ
0004CE E6CE AF               4      XOR A
0004CF E6CF 326FEA          13      LD  (CURSOR_X), A
0004D2 E6D2 18B7            12      JR  CO_CR                   ; CONOUT の CO_CR ラベルへ
       E6D4                     CO_HT_SAVE:
0004D4 E6D4 326FEA          13      LD  (CURSOR_X), A
0004D7 E6D7 1809            12      JR  CO_CURSOR_UPDATE        ; CONOUT の CO_CURSOR_UPDATE ラベルへ
                                
                                
                                    ;----------------------------------------------------------
                                    ; CO_VT  垂直タブ (0BH)
                                    ;
                                    ; Y を 1 増やす。X は変化しない。
                                    ; 最下行 (Y=24) の場合は SCROLL_UP。
                                    ; → CR (0DH) と動作が同じなので CO_CR に合流する。
                                    ;----------------------------------------------------------
       E6D9                     CO_VT:
0004D9 E6D9 18B0            12      JR  CO_CR                   ; CONOUT の CO_CR ラベルへ
                                
                                
                                    ;----------------------------------------------------------
                                    ; CO_FF  フォームフィード (0CH)
                                    ;
                                    ; 画面全消去 + カーソルを (0,0) へ。
                                    ;
                                    ; 処理内容:
                                    ;   [1] CURRENT_TLA_INDEX を 0 にリセット
                                    ;   [2] HD46505 Start Address を F800H に戻す
                                    ;   [3] VRAM テキスト領域 (F800H-FFCFH, 2000 バイト) を
                                    ;       スペース (20H) で埋める
                                    ;   [4] CURSOR_X, CURSOR_Y を 0 にリセット
                                    ;----------------------------------------------------------
       E6DB                     CO_FF:
                                ;     ; [1] スクロール状態をリセット
                                ;     XOR A
                                ;     LD  (CURRENT_TLA_INDEX), A
                                
                                ;     ; [2] HD46505 R12/R13 を F800H に戻す
                                ;     LD  A, CRTC_R12_START_H     ; R12: Start Address High
                                ;     OUT (CRTC_ADDRESS_PORT), A
                                ;     LD  A, 0F8H                 ; F800H 上位
                                ;     OUT (CRTC_VALUE_PORT), A
                                ;     LD  A, CRTC_R13_START_L     ; R13: Start Address Low
                                ;     OUT (CRTC_ADDRESS_PORT), A
                                ;     XOR A                       ; F800H 下位 = 00H
                                ;     OUT (CRTC_VALUE_PORT), A
                                
                                ;     ; [3] VRAM テキスト領域をスペースで全クリア
                                ;     ;     F800H から 7D0H (2000) バイト分
                                ;     LD  HL, VRAM_TXT_TOP           ; HL = F800H
                                ;     LD  BC, 07D0H               ; BC = 2000 バイト
                                ; CO_FF_CLEAR:
                                ;     LD  A, 20H
                                ;     OUT (VRAM_BANK_PORT), A     ; 次の命令を VRAM ページへ
                                ;     LD  (HL), A                 ; VRAM にスペースを書き込む
                                ;     INC HL
                                ;     DEC BC
                                ;     LD  A, B
                                ;     OR  C                       ; BC = 0?
                                ;     JR  NZ, CO_FF_CLEAR         ; No → 続ける
                                
                                ;     ; [4] カーソルを (0,0) へ
                                ;     XOR A
                                ;     LD  (CURSOR_X), A
                                ;     LD  (CURSOR_Y), A
0004DB E6DB 1805            12      JR  CO_CURSOR_UPDATE        ; CONOUT の CO_CURSOR_UPDATE ラベルへ
                                
       E6DD                     CO_BEL:
                                    ; BEL (07H): 無視
0004DD E6DD 1803            12      JR  CO_CURSOR_UPDATE        ; カーソル位置は変わらないが、更新しておく
                                
                                
                                    ;----------------------------------------------------------
                                    ; スクロール
                                    ; CURSOR_Y は 24 のまま。SCROLL_UP が最下行をクリアする。
                                    ;----------------------------------------------------------
       E6DF                     CO_SCROLL:
0004DF E6DF CDD0E5          17      CALL SCROLL_UP
                                    ; fall through
                                
                                    ;----------------------------------------------------------
                                    ; ハードウェアカーソル更新
                                    ; (X,Y) → VRAM アドレス → CURRENT_CURSOR_LOCATE → PRINT_CURSOR
                                    ;----------------------------------------------------------
       E6E2                     CO_CURSOR_UPDATE:
0004E2 E6E2 3A70EA          13      LD  A, (CURSOR_Y)
0004E5 E6E5 47               4      LD  B, A
0004E6 E6E6 3A6FEA          13      LD  A, (CURSOR_X)
0004E9 E6E9 4F               4      LD  C, A
0004EA E6EA CD8FE5          17      CALL GET_VRAM_ADDRESS_FROM_X_Y  ; HL = カーソル位置の VRAM アドレス
0004ED E6ED 2271EA          16      LD  (CURRENT_CURSOR_LOCATE), HL
0004F0 E6F0 CDF8E6          17      CALL PRINT_CURSOR
                                
0004F3 E6F3 E1              10      POP HL
0004F4 E6F4 D1              10      POP DE
0004F5 E6F5 C1              10      POP BC
0004F6 E6F6 F1              10      POP AF
0004F7 E6F7 C9              10      RET
                                
                                
                                ;==============================================================
                                ; PRINT_CURSOR
                                ;
                                ; カーソルをCURRENT_CURSOR_LOCATEの位置に表示する(HD46505Sの機能)
                                ;
                                ;==============================================================
       E6F8                     PRINT_CURSOR:
0004F8 E6F8 F5              11      PUSH AF
0004F9 E6F9 D5              11      PUSH DE
0004FA E6FA E5              11      PUSH HL
0004FB E6FB 2A71EA          16      LD HL,(CURRENT_CURSOR_LOCATE) ; 現在のカーソル位置をHLにロード
0004FE E6FE 3E0E             7      LD A,0EH ; R14 (cursor H)
000500 E700 D3F0            11      OUT (CRTC_ADDRESS_PORT),A
000502 E702 7C               4      LD A,H
000503 E703 D3F1            11      OUT (CRTC_VALUE_PORT),A ; カーソルの上位アドレス設定
000505 E705 3E0F             7      LD A,0FH ; R15 (cursor L)
000507 E707 D3F0            11      OUT (CRTC_ADDRESS_PORT),A
000509 E709 7D               4      LD A,L
00050A E70A D3F1            11      OUT (CRTC_VALUE_PORT),A ; カーソルの下位アドレス設定
00050C E70C E1              10      POP HL
00050D E70D D1              10      POP DE
00050E E70E F1              10      POP AF
00050F E70F C9              10      RET
                                
                                ;==============================================================
                                ; STRING_OUT
                                ;
                                ; 文字列をヌル終端 (00H) まで連続して VRAM へ書き込む。
                                ; 1文字ごとに WRITE_CHAR_AT_XY を呼ぶ。
                                ;
                                ; 入力:
                                ;   B  = Y  論理行 (0-24)
                                ;   C  = X  論理列 (0-79)  ※表示開始列
                                ;   HL = 文字列先頭アドレス
                                ;
                                ; 出力: なし
                                ; 破壊: A, DE, HL
                                ;         (BC は WRITE_CHAR_AT_XY が保存するため変化なし)
                                ;==============================================================
       E710                     STRING_OUT:
000510 E710 7E               7      LD   A, (HL)            ; 次の文字を読み出す
000511 E711 B7               4      OR   A                  ; ヌル終端 (00H) か?
000512 E712 C8              11      RET  Z                  ; 00H なら終了
                                
000513 E713 E5              11      PUSH HL                 ; 文字列ポインタを退避
                                                            ; (WRITE_CHAR_AT_XY は HL を破壊するため)
000514 E714 CD2DE6          17      CALL WRITE_CHAR_AT_X_Y  ; B=Y, C=X, A=文字 → VRAM へ書き込む
000517 E717 E1              10      POP  HL                 ; 文字列ポインタを復元
                                
000518 E718 23               6      INC  HL                 ; 次の文字へ
000519 E719 0C               4      INC  C                  ; X を +1 (次の列へ)
00051A E71A 18F4            12      JR   STRING_OUT
                                
                                ;==============================================================
                                ; キースキャン サブルーチン
                                ;==============================================================
       E71C                     KEY_SCAN_WRAPPER:
00051C E71C E5              11      PUSH HL
00051D E71D C5              11      PUSH BC
       E71E                     KEY_SCAN_WRAPPER_LOOP:
00051E E71E 2100EE          10      LD HL,PORT_INDEX
000521 E721 01DF0F          10      LD BC,0FDFH
000524 E724 CD2DE7          17      CALL KEY_SCAN
000527 E727 A7               4      AND A
000528 E728 28F4            12      JR Z,KEY_SCAN_WRAPPER_LOOP
00052A E72A C1              10      POP BC
00052B E72B E1              10      POP HL
00052C E72C C9              10      RET
                                
       E72D                     KEY_SCAN:
00052D E72D 0C               4      INC C
00052E E72E EDA2            16      INI ; INIでキーボードポートE0~EFをスキャンする。
000530 E730 20FB            12      JR NZ,KEY_SCAN ; Cをインクリメントしていくと、1->2->3...e->f->0となって、スキャン終了となる。
000532 E732 2100EE          10      LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
000535 E735 01DF0F          10      LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
       E738                     SCAN_LOOP:
000538 E738 0C               4      INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
000539 E739 ED78            12      IN A,(C)
00053B E73B A6               7      AND (HL) ; INIでスキャンした結果と照合。
00053C E73C 77               7      LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
00053D E73D 23               6      INC HL ; メモリアドレスをインクリメント。
00053E E73E 10F8            13      DJNZ SCAN_LOOP ; 16回繰り返す
                                
000540 E740 2100EE          10      LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
000543 E743 1600             7      LD D,0H ; インデックスを0にする。
000545 E745 1801            12      JR KEY_LOOP_1
       E747                     SCAN_LOOP_RETURN:
000547 E747 C9              10      RET
                                
       E748                     KEY_LOOP_1:
000548 E748 7E               7      LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
000549 E749 A7               4      AND A ; 0でないか、つまり、空の値でないかチェック。
00054A E74A 200B            12      JR NZ, KEY_LOOP_2 ; 空でない場合、つまり、何かが押されているならジャンプ
00054C E74C 14               4      INC D ; インデックスをインクリメント
00054D E74D 23               6      INC HL ; ポインタをインクリメント
00054E E74E 7A               4      LD A,D
00054F E74F FE0F             7      CP 0FH ; 16バイトチェックしたか？
000551 E751 3E00             7      LD A,0H ; なにもキーが押されなかったときはAレジスタを0にする。
000553 E753 28F2            12      JR Z,SCAN_LOOP_RETURN ; 終了
000555 E755 18F1            12      JR KEY_LOOP_1 
                                
                                ;
                                ; 何かが押されている時に実行される。
                                ;
                                
       E757                     KEY_LOOP_2: 
000557 E757 FE04             7      CP 04H ; キーボード1段目のキーが押された。(ESC,1,2,3,4,5,6,7,8,9,0,-,=,BS)
000559 E759 CA70E7          10      JP Z, CODE_04
                                
00055C E75C FE08             7      CP 08H ; キーボード2段目のキーが押された。(TAB,q,w,e,r,t,y,u,i,o,p,CR)
00055E E75E CA8CE7          10      JP Z, CODE_08
                                
000561 E761 FE10             7      CP 10H ; キーボード3段目のキーが押された。(control,a,s,d,f,g,h,j,k,l)
000563 E763 CAA8E7          10      JP Z, CODE_10
                                
000566 E766 FE20             7      CP 20H ; キーボード4段目のキーが押された。(shift,z,x,c,v,b,n,m,shift)
000568 E768 CAC4E7          10      JP Z, CODE_20
                                
00056B E76B FE40             7      CP 40H
00056D E76D CAE0E7          10      JP Z, CODE_40
                                
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;  CODE 04 キーボードの1段目
                                ;  (esc,1,2,3,4,5,6,7,8,9,0,-,=,bs)
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                
       E770                     CODE_04:
000570 E770 7D               4      LD A, L
000571 E771 E60F             7      AND 0FH
                                
000573 E773 FE00             7      CP 00H ; ESCキーか？
000575 E775 CAF9E7          10      JP Z, CODE_ESC ; ESCキー処理へ
                                
000578 E778 45               4      LD B,L
000579 E779 DD2173EA        14      LD IX, KEY_MAP
       E77D                     MAP_ADD_04:
00057D E77D DD23            10      INC IX
00057F E77F 10FC            13      DJNZ MAP_ADD_04
000581 E781 DD7E00          19      LD A,(IX+0)
000584 E784 F5              11      PUSH AF
000585 E785 CD08E8          17      CALL KEY_BREAK_WAIT
000588 E788 F1              10      POP AF
000589 E789 C347E7          10      JP SCAN_LOOP_RETURN
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;  CODE 08 キーボードの2段目
                                ;  (tab,q,w,e,r,t,y,u,i,o,p,cr)
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                
       E78C                     CODE_08:
00058C E78C 7D               4      LD A, L ; ここでPORT_INDEXの下位8ビットのみを取り出している。
                                            ; これをインデックスに使っているので、PORT_INDEXのアドレスの下位8ビットの先頭は0でなくてはならない。
00058D E78D E60F             7      AND 0FH
                                
00058F E78F FE00             7      CP 00H ; TABキーか？
000591 E791 CAEFE7          10      JP Z, CODE_TAB ; TABキー処理へ
                                
000594 E794 45               4      LD B,L
000595 E795 DD2173EA        14      LD IX, KEY_MAP
       E799                     MAP_ADD_08:
000599 E799 DD23            10      INC IX
00059B E79B 10FC            13      DJNZ MAP_ADD_08
00059D E79D DD7E10          19      LD A,(IX+10H)
0005A0 E7A0 F5              11      PUSH AF
0005A1 E7A1 CD08E8          17      CALL KEY_BREAK_WAIT
0005A4 E7A4 F1              10      POP AF
0005A5 E7A5 C347E7          10      JP SCAN_LOOP_RETURN
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;  CODE 10 キーボードの3段目
                                ;  (control,a,s,d,f,g,h,j,k,l)
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
       E7A8                     CODE_10:
0005A8 E7A8 7D               4      LD A, L ; ここでPORT_INDEXの下位8ビットのみを取り出している。
                                            ; これをインデックスに使っているので、PORT_INDEXのアドレスの下位8ビットの先頭は0でなくてはならない。
0005A9 E7A9 E60F             7      AND 0FH
                                
0005AB E7AB FE00             7      CP 00H ; コントロールキーか？
0005AD E7AD CAE3E7          10      JP Z, CODE_CONTROL ; コントロールキー処理へ
                                
0005B0 E7B0 45               4      LD B,L
0005B1 E7B1 DD2173EA        14      LD IX, KEY_MAP
       E7B5                     MAP_ADD_10:
0005B5 E7B5 DD23            10      INC IX
0005B7 E7B7 10FC            13      DJNZ MAP_ADD_10
0005B9 E7B9 DD7E20          19      LD A,(IX+20H)
0005BC E7BC F5              11      PUSH AF
0005BD E7BD CD08E8          17      CALL KEY_BREAK_WAIT
0005C0 E7C0 F1              10      POP AF
                                
0005C1 E7C1 C347E7          10      JP SCAN_LOOP_RETURN
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;  CODE 20 キーボードの4段目
                                ;  (shift,z,x,c,v,b,n,m,shift)
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
       E7C4                     CODE_20:
0005C4 E7C4 7D               4      LD A, L ; ここでPORT_INDEXの下位8ビットのみを取り出している。
                                            ; これをインデックスに使っているので、PORT_INDEXのアドレスの下位8ビットの先頭は0でなくてはならない。
0005C5 E7C5 E60F             7      AND 0FH
                                
0005C7 E7C7 FE00             7      CP 00H
0005C9 E7C9 CAE9E7          10      JP Z, CODE_SHIFT ; シフトキー処理へ
                                
0005CC E7CC 45               4      LD B,L
0005CD E7CD DD2173EA        14      LD IX, KEY_MAP
       E7D1                     MAP_ADD_20:
0005D1 E7D1 DD23            10      INC IX
0005D3 E7D3 10FC            13      DJNZ MAP_ADD_20
0005D5 E7D5 DD7E30          19      LD A,(IX+30H)
0005D8 E7D8 F5              11      PUSH AF
0005D9 E7D9 CD08E8          17      CALL KEY_BREAK_WAIT
0005DC E7DC F1              10      POP AF
0005DD E7DD C347E7          10      JP SCAN_LOOP_RETURN
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ;  CODE 40 キーボードの5段目
                                ;
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;
       E7E0                     CODE_40:
0005E0 E7E0 C303E8          10      JP KEY_LOOP_END
                                
                                ;
                                ; 特殊キー(CONTROL,SHIFT, TAB)の処理
                                ;
                                
       E7E3                     CODE_CONTROL:
0005E3 E7E3 CD33E9          17      CALL CONTROL_KEY_NEXT_GET
0005E6 E7E6 C347E7          10      JP SCAN_LOOP_RETURN
                                
       E7E9                     CODE_SHIFT:
0005E9 E7E9 CD2BE8          17      CALL SHIFT_KEY_NEXT_GET
0005EC E7EC C347E7          10      JP SCAN_LOOP_RETURN
                                
       E7EF                     CODE_TAB:
0005EF E7EF 3E09             7      LD A,09H ; TABキーコード
0005F1 E7F1 F5              11      PUSH AF
0005F2 E7F2 CD08E8          17      CALL KEY_BREAK_WAIT
0005F5 E7F5 F1              10      POP AF
0005F6 E7F6 C347E7          10      JP SCAN_LOOP_RETURN
                                
       E7F9                     CODE_ESC:
0005F9 E7F9 3E1B             7      LD A,ESC ; ESCキーコード(1BH)
0005FB E7FB F5              11      PUSH AF
0005FC E7FC CD08E8          17      CALL KEY_BREAK_WAIT
0005FF E7FF F1              10      POP AF
000600 E800 C347E7          10      JP SCAN_LOOP_RETURN
                                
       E803                     KEY_LOOP_END:
000603 E803 3E1B             7      LD A, ESC ; どれにも該当しないキーを押したときは、エスケープキー(1BH)を押したことにする。
000605 E805 C347E7          10      JP SCAN_LOOP_RETURN
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; キーの押下が解放されるまで待つサブルーチン
                                ;
                                
       E808                     KEY_BREAK_WAIT:
000608 E808 2100EE          10      LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
00060B E80B 01DF0F          10      LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
       E80E                     BREAK_SCAN_LOOP:
00060E E80E 0C               4      INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
00060F E80F ED78            12      IN A,(C)
000611 E811 A6               7      AND (HL) ; INIでスキャンした結果と照合。
000612 E812 77               7      LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
000613 E813 23               6      INC HL ; メモリアドレスをインクリメント。
000614 E814 10F8            13      DJNZ BREAK_SCAN_LOOP ; 16回繰り返す
                                
000616 E816 2100EE          10      LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
000619 E819 1600             7      LD D,0H ; インデックスを0にする。
00061B E81B 060F             7      LD B,0FH
00061D E81D 1E00             7      LD E,0H
                                
       E81F                     BREAK_KEY_LOOP:
00061F E81F 7E               7      LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
000620 E820 83               4      ADD A, E 
000621 E821 5F               4      LD E, A ; Eにキースキャンの値を積算する。
000622 E822 14               4      INC D ; インデックスをインクリメント
000623 E823 23               6      INC HL ; ポインタをインクリメント
000624 E824 10F9            13      DJNZ BREAK_KEY_LOOP
000626 E826 7B               4      LD A,E ; キースキャンの値の総和をAに戻す。
000627 E827 A7               4      AND A ; ゼロかどうか判定の為、自分自身でANDをとる。
000628 E828 C8              11      RET Z ; 全てのキーボードポートが0の時にリターンする。
000629 E829 18DD            12      JR KEY_BREAK_WAIT
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; SHIFTキーと同時に押されたキーをゲットするサブルーチン
                                ;
                                
       E82B                     SHIFT_KEY_NEXT_GET:
00062B E82B 2100EE          10      LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
00062E E82E 01DF0F          10      LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
       E831                     SHIFT_SCAN_LOOP:
000631 E831 0C               4      INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
000632 E832 ED78            12      IN A,(C)
000634 E834 77               7      LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
000635 E835 23               6      INC HL ; メモリアドレスをインクリメント。
000636 E836 10F9            13      DJNZ SHIFT_SCAN_LOOP ; 16回繰り返す
                                
000638 E838 2100EE          10      LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
00063B E83B 1600             7      LD D,0H ; インデックスを 1 にする。
00063D E83D 060F             7      LD B,0FH ; B=FH=16
00063F E83F 1E00             7      LD E,0H
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; SHIFTキーを離すか、他のキーが押されるまではループする。
                                ;
                                
       E841                     SHIFT_NEXT_KEY_LOOP:
000641 E841 3A00EE          13      LD A, (PORT_INDEX)
000644 E844 A7               4      AND A
000645 E845 3E1B             7      LD A,1BH
000647 E847 C8              11      RET Z ; [EE00]=0、SHIFTキー押されてないならリターンする。
000648 E848 23               6      INC HL
000649 E849 14               4      INC D
00064A E84A 7E               7      LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
00064B E84B A7               4      AND A
00064C E84C 2007            12      JR NZ, SHIFT_KEY_LOOP ; キーが押下されている時はジャンプする。
00064E E84E 7A               4      LD A,D
00064F E84F FE0F             7      CP 0FH ; D=A=16バイトチェックしたか？
000651 E851 28D8            12      JR Z, SHIFT_KEY_NEXT_GET ; 16バイト読み込んで、SHIFTキー以外何も押されていないなら、一番最初のループに戻る
000653 E853 18EC            12      JR SHIFT_NEXT_KEY_LOOP ; 16バイト読んでないなら、次のメモリを読む。
                                    
       E855                     SHIFT_KEY_LOOP:
000655 E855 FE04             7      CP 04H
000657 E857 CA69E8          10      JP Z, CODE_04_SHIFT
00065A E85A FE08             7      CP 08H
00065C E85C CA99E8          10      JP Z, CODE_08_SHIFT
00065F E85F FE10             7      CP 10H
000661 E861 CAA6E8          10      JP Z, CODE_10_SHIFT
000664 E864 FE20             7      CP 20H
000666 E866 CAB8E8          10      JP Z, CODE_20_SHIFT
                                
       E869                     CODE_04_SHIFT:
000669 E869 7D               4      LD A,L
00066A E86A E60F             7      AND 0FH
                                
00066C E86C FE01             7      CP 01H
00066E E86E CACDE8          10      JP Z, CODE_1_SHIFT
000671 E871 FE02             7      CP 02H
000673 E873 CAD3E8          10      JP Z, CODE_2_SHIFT
000676 E876 FE03             7      CP 03H
000678 E878 CAD9E8          10      JP Z, CODE_3_SHIFT
00067B E87B FE04             7      CP 04H
00067D E87D CADFE8          10      JP Z, CODE_4_SHIFT
000680 E880 FE05             7      CP 05H
000682 E882 CAE5E8          10      JP Z, CODE_5_SHIFT
000685 E885 FE06             7      CP 06H
000687 E887 CAEBE8          10      JP Z, CODE_6_SHIFT
00068A E88A FE07             7      CP 07H
00068C E88C CAF1E8          10      JP Z, CODE_7_SHIFT
00068F E88F FE08             7      CP 08H
000691 E891 CAF7E8          10      JP Z, CODE_8_SHIFT
000694 E894 FE09             7      CP 09H
000696 E896 CAFDE8          10      JP Z, CODE_9_SHIFT
                                
       E899                     CODE_08_SHIFT:
000699 E899 7D               4      LD A,L
00069A E89A E60F             7      AND 0FH
                                
00069C E89C FE0B             7      CP 0BH
00069E E89E CA03E9          10      JP Z, CODE_AT_MARK_SHIFT
0006A1 E8A1 FE0C             7      CP 0CH
0006A3 E8A3 CA09E9          10      JP Z, CODE_L_SQ_PAR_SHIFT
                                
       E8A6                     CODE_10_SHIFT:
0006A6 E8A6 7D               4      LD A,L
0006A7 E8A7 E60F             7      AND 0FH
                                
0006A9 E8A9 FE0A             7      CP 0AH
0006AB E8AB CA0FE9          10      JP Z, CODE_SEMI_COLON_SHIFT
0006AE E8AE FE0B             7      CP 0BH
0006B0 E8B0 CA15E9          10      JP Z, CODE_COLON_SHIFT
0006B3 E8B3 FE0C             7      CP 0CH
0006B5 E8B5 CA1BE9          10      JP Z, CODE_R_SQ_PAR_SHIFT
                                
       E8B8                     CODE_20_SHIFT:
0006B8 E8B8 7D               4      LD A,L
0006B9 E8B9 E60F             7      AND 0FH
                                
0006BB E8BB FE09             7      CP 09H
0006BD E8BD CA21E9          10      JP Z, CODE_COMMA_SHIFT
0006C0 E8C0 FE0A             7      CP 0AH
0006C2 E8C2 CA27E9          10      JP Z, CODE_PERIOD_SHIFT
0006C5 E8C5 FE0B             7      CP 0BH
0006C7 E8C7 CA2DE9          10      JP Z, CODE_SLASH_SHIFT
                                
0006CA E8CA 3E00             7      LD A,0H
0006CC E8CC C9              10      RET
                                
       E8CD                     CODE_1_SHIFT:
0006CD E8CD CD08E8          17      CALL KEY_BREAK_WAIT
0006D0 E8D0 3E21             7      LD A, '!'
0006D2 E8D2 C9              10      RET
       E8D3                     CODE_2_SHIFT:
0006D3 E8D3 CD08E8          17      CALL KEY_BREAK_WAIT
0006D6 E8D6 3E22             7      LD A, 22H
0006D8 E8D8 C9              10      RET
       E8D9                     CODE_3_SHIFT:
0006D9 E8D9 CD08E8          17      CALL KEY_BREAK_WAIT
0006DC E8DC 3E23             7      LD A, '#'
0006DE E8DE C9              10      RET
       E8DF                     CODE_4_SHIFT:
0006DF E8DF CD08E8          17      CALL KEY_BREAK_WAIT
0006E2 E8E2 3E24             7      LD A, '$'
0006E4 E8E4 C9              10      RET
       E8E5                     CODE_5_SHIFT:
0006E5 E8E5 CD08E8          17      CALL KEY_BREAK_WAIT
0006E8 E8E8 3E25             7      LD A, '%'
0006EA E8EA C9              10      RET
       E8EB                     CODE_6_SHIFT:
0006EB E8EB CD08E8          17      CALL KEY_BREAK_WAIT
0006EE E8EE 3E26             7      LD A, '&'
0006F0 E8F0 C9              10      RET
       E8F1                     CODE_7_SHIFT:
0006F1 E8F1 CD08E8          17      CALL KEY_BREAK_WAIT
0006F4 E8F4 3E27             7      LD A, 27H ; 27Hは "'" 。シングルクォーテーション。
0006F6 E8F6 C9              10      RET
       E8F7                     CODE_8_SHIFT:
0006F7 E8F7 CD08E8          17      CALL KEY_BREAK_WAIT
0006FA E8FA 3E28             7      LD A, '('
0006FC E8FC C9              10      RET
       E8FD                     CODE_9_SHIFT:
0006FD E8FD CD08E8          17      CALL KEY_BREAK_WAIT
000700 E900 3E29             7      LD A, ')'
000702 E902 C9              10      RET
                                
       E903                     CODE_AT_MARK_SHIFT:
000703 E903 CD08E8          17      CALL KEY_BREAK_WAIT
000706 E906 3E60             7      LD A, '`'
000708 E908 C9              10      RET
       E909                     CODE_L_SQ_PAR_SHIFT:
000709 E909 CD08E8          17      CALL KEY_BREAK_WAIT
00070C E90C 3E7B             7      LD A, '{'
00070E E90E C9              10      RET
       E90F                     CODE_SEMI_COLON_SHIFT:
00070F E90F CD08E8          17      CALL KEY_BREAK_WAIT
000712 E912 3E2B             7      LD A, '+'
000714 E914 C9              10      RET
       E915                     CODE_COLON_SHIFT:
000715 E915 CD08E8          17      CALL KEY_BREAK_WAIT
000718 E918 3E2A             7      LD A, '*'
00071A E91A C9              10      RET
       E91B                     CODE_R_SQ_PAR_SHIFT:
00071B E91B CD08E8          17      CALL KEY_BREAK_WAIT
00071E E91E 3E7D             7      LD A, '}'
000720 E920 C9              10      RET
       E921                     CODE_COMMA_SHIFT:
000721 E921 CD08E8          17      CALL KEY_BREAK_WAIT
000724 E924 3E3C             7      LD A, '<'
000726 E926 C9              10      RET
       E927                     CODE_PERIOD_SHIFT:
000727 E927 CD08E8          17      CALL KEY_BREAK_WAIT
00072A E92A 3E3E             7      LD A, '>'
00072C E92C C9              10      RET
       E92D                     CODE_SLASH_SHIFT:
00072D E92D CD08E8          17      CALL KEY_BREAK_WAIT
000730 E930 3E3F             7      LD A, '?'
000732 E932 C9              10      RET
                                
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; Controlキーと同時に押されたキーをゲットするサブルーチン
                                ;
                                
       E933                     CONTROL_KEY_NEXT_GET:
000733 E933 2100EE          10      LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
000736 E936 01DF0F          10      LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
       E939                     CONTROL_SCAN_LOOP:
000739 E939 0C               4      INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
00073A E93A ED78            12      IN A,(C)
00073C E93C 77               7      LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
00073D E93D 23               6      INC HL ; メモリアドレスをインクリメント。
00073E E93E 10F9            13      DJNZ CONTROL_SCAN_LOOP ; 16回繰り返す
                                
000740 E940 2100EE          10      LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
000743 E943 1600             7      LD D,0H ; インデックスを 1 にする。
000745 E945 060F             7      LD B,0FH ; B=FH=16
000747 E947 1E00             7      LD E,0H
                                
                                ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                ;
                                ; Controlキーを離すか、他のキーが押されるまではループする。
                                ;
                                
       E949                     CONTROL_NEXT_KEY_LOOP:
000749 E949 3A00EE          13      LD A, (PORT_INDEX)
00074C E94C A7               4      AND A
00074D E94D 3E1B             7      LD A,1BH
00074F E94F C8              11      RET Z ; [EE00]=0、SHIFTキー押されてないならリターンする。
000750 E950 23               6      INC HL
000751 E951 14               4      INC D
000752 E952 7E               7      LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
000753 E953 A7               4      AND A
000754 E954 2007            12      JR NZ, CONTROL_KEY_LOOP ; キーが押下されている時はジャンプする。
000756 E956 7A               4      LD A,D
000757 E957 FE0F             7      CP 0FH ; D=A=16バイトチェックしたか？
000759 E959 28D8            12      JR Z, CONTROL_KEY_NEXT_GET ; 16バイト読み込んで、SHIFTキー以外何も押されていないなら、一番最初のループに戻る
00075B E95B 18EC            12      JR CONTROL_NEXT_KEY_LOOP ; 16バイト読んでないなら、次のメモリを読む。
                                    
       E95D                     CONTROL_KEY_LOOP:
00075D E95D FE08             7      CP 08H
00075F E95F CA6CE9          10      JP Z, CODE_08_CONTROL
000762 E962 FE10             7      CP 10H
000764 E964 CA83E9          10      JP Z, CODE_10_CONTROL
000767 E967 FE20             7      CP 20H
000769 E969 CA8BE9          10      JP Z, CODE_20_CONTROL
                                
                                
       E96C                     CODE_08_CONTROL:
00076C E96C 7D               4      LD A,L
00076D E96D E60F             7      AND 0FH
                                
00076F E96F FE03             7      CP 03H
000771 E971 CAA0E9          10      JP Z, CODE_E_CONTROL
000774 E974 FE04             7      CP 04H
000776 E976 CAB2E9          10      JP Z, CODE_R_CONTROL
000779 E979 FE07             7      CP 07H
00077B E97B CABEE9          10      JP Z, CODE_U_CONTROL
00077E E97E FE0A             7      CP 0AH
000780 E980 CAACE9          10      JP Z, CODE_P_CONTROL
                                
       E983                     CODE_10_CONTROL:
000783 E983 7D               4      LD A,L
000784 E984 E60F             7      AND 0FH
                                
000786 E986 FE02             7      CP 02H
000788 E988 CAB8E9          10      JP Z, CODE_S_CONTROL
                                
       E98B                     CODE_20_CONTROL:
00078B E98B 7D               4      LD A,L
00078C E98C E60F             7      AND 0FH
                                
00078E E98E FE01             7      CP 01H
000790 E990 CACAE9          10      JP Z, CODE_Z_CONTROL
000793 E993 FE02             7      CP 02H
000795 E995 CAC4E9          10      JP Z, CODE_X_CONTROL
000798 E998 FE03             7      CP 03H
00079A E99A CAA6E9          10      JP Z, CODE_C_CONTROL
                                
00079D E99D 3E00             7      LD A,0H
00079F E99F C9              10      RET
                                
                                
       E9A0                     CODE_E_CONTROL:
0007A0 E9A0 CD08E8          17      CALL KEY_BREAK_WAIT
0007A3 E9A3 3E05             7      LD A, 05H
0007A5 E9A5 C9              10      RET
       E9A6                     CODE_C_CONTROL:
0007A6 E9A6 CD08E8          17      CALL KEY_BREAK_WAIT
0007A9 E9A9 3E03             7      LD A, 03H
0007AB E9AB C9              10      RET
       E9AC                     CODE_P_CONTROL:
0007AC E9AC CD08E8          17      CALL KEY_BREAK_WAIT
0007AF E9AF 3E10             7      LD A, 10H
0007B1 E9B1 C9              10      RET
       E9B2                     CODE_R_CONTROL:
0007B2 E9B2 CD08E8          17      CALL KEY_BREAK_WAIT
0007B5 E9B5 3E12             7      LD A, 12H
0007B7 E9B7 C9              10      RET
       E9B8                     CODE_S_CONTROL:
0007B8 E9B8 CD08E8          17      CALL KEY_BREAK_WAIT
0007BB E9BB 3E13             7      LD A, 13H
0007BD E9BD C9              10      RET
       E9BE                     CODE_U_CONTROL:
0007BE E9BE CD08E8          17      CALL KEY_BREAK_WAIT
0007C1 E9C1 3E15             7      LD A, 15H
0007C3 E9C3 C9              10      RET
       E9C4                     CODE_X_CONTROL:
0007C4 E9C4 CD08E8          17      CALL KEY_BREAK_WAIT
0007C7 E9C7 3E18             7      LD A, 18H
0007C9 E9C9 C9              10      RET
       E9CA                     CODE_Z_CONTROL:
0007CA E9CA CD08E8          17      CALL KEY_BREAK_WAIT
0007CD E9CD 3E1A             7      LD A, 1AH
0007CF E9CF C9              10      RET
                                
                                
                                ;==============================================================
                                ; CTC初期化ルーチン
                                ;==============================================================
       E9D0                     CTC_INIT:
0007D0 E9D0 F3               4          DI                  ; 割り込み禁止
                                
                                        ; Iレジスタ設定（IM2テーブルの上位バイト）
0007D1 E9D1 3EFF             7          LD   A, 0FFh
0007D3 E9D3 ED47             9          LD   I, A
                                
                                        ; IM2モード設定
0007D5 E9D5 ED5E             8          IM   2
                                
                                        ; 割り込みベクタテーブル初期化
                                        ; 0xFF00からの256バイト（128エントリ）をダミーISRで埋める
0007D7 E9D7 2100FF          10          LD   HL, IM2_TABLE
0007DA E9DA 11FCE9          10          LD   DE, DUMMY_ISR
0007DD E9DD 0680             7          LD   B, 128         ; 128エントリ（256バイト）
       E9DF                     INIT_LOOP:
0007DF E9DF 73               7          LD   (HL), E        ; 下位バイト
0007E0 E9E0 23               6          INC  HL
0007E1 E9E1 72               7          LD   (HL), D        ; 上位バイト
0007E2 E9E2 23               6          INC  HL
0007E3 E9E3 10FA            13          DJNZ INIT_LOOP
                                
                                        ; Ch0用ISRアドレスを設定（明示的に0xFF00に書き込む）
0007E5 E9E5 2100FF          10          LD   HL, IM2_TABLE  ; HL = 0xFF00
0007E8 E9E8 11FFE9          10          LD   DE, CTC_CH0_ISR
0007EB E9EB 73               7          LD   (HL), E        ; 下位バイトを0xFF00に
0007EC E9EC 23               6          INC  HL
0007ED E9ED 72               7          LD   (HL), D        ; 上位バイトを0xFF01に
                                
                                        ; CTCベクタベース設定
0007EE E9EE 3E00             7          LD   A, VEC_BASE
0007F0 E9F0 D3FC            11          OUT  (CTC_CH0), A
                                
                                        ; Ch0制御ワード設定
0007F2 E9F2 3EB5             7          LD   A, 0B5h
0007F4 E9F4 D3FC            11          OUT  (CTC_CH0), A
                                
                                        ; タイムコンスタント設定（156 = 約10ms）
0007F6 E9F6 3E9C             7          LD   A, 156
0007F8 E9F8 D3FC            11          OUT  (CTC_CH0), A
                                
0007FA E9FA FB               4          EI                  ; 割り込み許可
0007FB E9FB C9              10          RET
                                
                                ;==============================================================
                                ; ダミーISR（何もしないでリターン）
                                ;==============================================================
       E9FC                     DUMMY_ISR:
0007FC E9FC FB               4          EI
0007FD E9FD ED4D            15          RETI
                                
                                ;==============================================================
                                ; CTC Ch0割り込みサービスルーチン
                                ;==============================================================
       E9FF                     CTC_CH0_ISR:
0007FF E9FF F3               4          DI          ; 割り込み禁止
000800 EA00 F5              11          PUSH AF
000801 EA01 C5              11          PUSH BC
000802 EA02 D5              11          PUSH DE
000803 EA03 E5              11          PUSH HL
                                
                                        ; ; 10msカウンタをインクリメント
                                        ; LD   A, (SOFT_TICKS)
                                        ; INC  A
                                        ; LD   (SOFT_TICKS), A
                                
                                        ; ; 2回に1回（20ms）だけ処理
                                        ; CP   2
                                        ; ; CP   0AH
                                
                                        ; JR   C, ISR_END     ; まだ2未満ならスキップ
                                
                                        ; ; カウンタリセット
                                        ; XOR  A
                                        ; LD   (SOFT_TICKS), A
                                
                                        ; ; ここに20ms周期の処理を書く
                                        ; ; LD   HL, TICK_COUNTER
                                        ; ; INC  (HL)           ; 20msカウンタをインクリメント
       EA04                     ISR_END:
000804 EA04 E1              10          POP  HL
000805 EA05 D1              10          POP  DE
000806 EA06 C1              10          POP  BC
000807 EA07 F1              10          POP  AF
000808 EA08 FB               4          EI          ; 割り込み許可
000809 EA09 ED4D            15          RETI
                                
                                
                                ;==============================================================
                                ; DMA COMMAND CHAIN
                                ;==============================================================
       EA0B                     DMA_COMMANDS:
00080B EA0B 15C3C3C3C3C3C3          DB 15H,0C3H,0C3H,0C3H,0C3H,0C3H,0C3H
000812 EA12 BB01BF                  DB 0BBH,01H,0BFH
000815 EA15 6D                      DB 6DH
000816 EA16 C3FF002C108D            DB 0C3H,0FFH,00H,2CH,010H,8DH
00081C EA1C C8                      DB hstbuf.@L
00081D EA1D EA                      DB hstbuf.@H ; this address is hstbuf address !!!!
00081E EA1E 8A                      DB 8AH
00081F EA1F CF87                    DB 0CFH,87H
       EA21                     DMA_WRITE_COMMANDS:
000821 EA21 16C3C3C3C3C3C3          DB 16H,0C3H,0C3H,0C3H,0C3H,0C3H,0C3H
000828 EA28 83                      DB 83H ; STOP DMA
000829 EA29 79                      DB 79H ; B->A
00082A EA2A C8                      DB hstbuf.@L
00082B EA2B EA                      DB hstbuf.@H  ; this address is hstbuf address !!!
00082C EA2C 00FF                    DB 00H,0FFH ; 256yte transfer
00082E EA2E 14288D                  DB 14H,28H,8DH
000831 EA31 C300                    DB 0C3H,00H ; FDC data register
000833 EA33 8A                      DB 8AH
000834 EA34 CF05                    DB 0CFH,05H
000836 EA36 CF87                    DB 0CFH,87H
                                
                                ;==============================================================
                                ; DMA WBOOT COMMAND CHAIN
                                ;==============================================================
       EA38                     DMA_WBOOT_COMMANDS:
000838 EA38 15C3C3C3C3C3C3          DB 15H,0C3H,0C3H,0C3H,0C3H,0C3H,0C3H
00083F EA3F BB01BF                  DB 0BBH,01H,0BFH
000842 EA42 6D                      DB 6DH
000843 EA43 C3FF002C108D            DB 0C3H,0FFH,00H,2CH,10H,8DH
000849 EA49 00CC                wboot_address:  DB 00H,0CCH ; CC00H is 58K MEMORY MODEL
00084B EA4B 8A                      DB 8AH
00084C EA4C CF87                    DB 0CFH,87H
                                
                                ;==============================================================
                                ; OPENMSG
                                ;============================================================== 
       EA4E                     OPENMSG:
00084E EA4E 534F5244204D3233        DB "SORD M23 CP/M-80 V2.2 58K SYSTEM",00H
            2043502F4D2D3830    
            2056322E32203538    
            4B2053595354454D    
            00                  
                                ;COPYMSG:
                                ;   DB "Copyright 1979 (C) by Digital Research.",CR,LF,00H
                                
                                
                                ;==============================================================
                                ; SORD M23 memory
                                ;==============================================================
                                ;==============================================================
                                ; for CRT control
                                ;==============================================================
                                ;==============================================================
                                ; データ領域 (CONOUT が使用)
                                ;==============================================================
       EA6F                     CURSOR_X:
00086F EA6F 00                      DB  0                   ; 現在のカーソル X 座標 (0-79)
       EA70                     CURSOR_Y:
000870 EA70 00                      DB  0                   ; 現在のカーソル Y 座標 (0-24)
       EA71                     CURRENT_CURSOR_LOCATE:
000871 EA71 00F8                    DW  F800H              ; カーソルの VRAM アドレス (PRINT_CURSOR が参照)
                                
                                
                                ;==============================================================
                                ; Keyboard map
                                ;==============================================================
       EA73                     KEY_MAP:
000873 EA73 0031323334353637        DB 0H,'1234567890-=',5CH,08H,0H
            3839302D3D5C0800    
000883 EA83 0051574552545955        DB 0H,'QWERTYUIOP@',5BH,0DH,0DH,0H
            494F50405B0D0D00    
000893 EA93 004153444647484A        DB 0H,'ASDFGHJKL',3BH,3AH,5DH,0H,0H,0H
            4B4C3B3A5D000000    
0008A3 EAA3 005A58435642204E        DB 0H,'ZXCVB',20H,'NM',2CH,2EH,2FH,0H,0H,0H
            4D2C2E2F000000      
                                
                                ;==============================================================
                                ;
                                ; Unitialized RAM data areas
                                ;
                                ;==============================================================
       EAB2                     sekdsk:     DS  1   ;seek disk number
       EAB3                     sektrk:     DS  2   ;seek track number
       EAB5                     seksec:     DS  1   ;seek sector number
                                ;
       EAB6                     hstdsk:     DS  1   ;host disk number
       EAB7                     hsttrk:     DS  2   ;host track number
       EAB9                     hstsec:     DS  1   ;host sector number
                                ;
       EABA                     sekhst:     DS  1   ;seek shr secshf
       EABB                     hstact:     DS  1   ;host active flag
       EABC                     hstwrt:     DS  1   ;host written flag
                                ;
       EABD                     unacnt:     DS  1   ;unalloc rec cnt
       EABE                     unadsk:     DS  1   ;last unalloc disk
       EABF                     unatrk:     DS  2   ;last unalloc track
       EAC1                     unasec:     DS  1   ;last unalloc sector
                                ;
       EAC2                     erflag:     DS  1   ;error reporting
       EAC3                     rsflag:     DS  1   ;read sector flag
       EAC4                     readop:     DS  1   ;1 if read operation
       EAC5                     wrtype:     DS  1   ;write operation type
       EAC6                     dmaadr:     DS  2   ;last dma address
       EAC8                     hstbuf:     DS  hstsiz  ;host buffer
                                ;
                                ;   the remainder of the cbios is reserved uninitialized
                                ;   data area, and does not need to be a Part of the
                                ;   system  memory image (the space must be available,
                                ;   however, between"begdat" and"enddat").
                                ;
       EBC8                     track:      DS  2   ;two bytes for expansion
       EBCA                     sector:     DS  2   ;two bytes for expansion
       EBCC                     dmaad:      DS  2   ;direct memory address
       EBCE                     diskno:     DS  1   ;disk number 0-15
                                ;
                                ;   scratch ram area for bdos use
       EBCF                     begdat  EQU $   ;beginning of data area
       EBCF                     dirbf:      DS  128 ;scratch directory area
       EC4F                     all00:      DS  31  ;allocation vector 0
       EC6E                     all01:      DS  31  ;allocation vector 1
       EC8D                     all02:      DS  31  ;allocation vector 2
       ECAC                     all03:      DS  31  ;allocation vector 3
       ECCB                     chk00:      DS  16  ;check vector 0
       ECDB                     chk01:      DS  16  ;check vector 1
       ECEB                     chk02:      DS  16  ;check vector 2
       ECFB                     chk03:      DS  16  ;check vector 3
                                
       ED0B                     SOFT_TICKS:   DS   2 ; 10msカウンタ（0または1）
       ED0D                     TICK_COUNTER: DS   2 ; タイマーカウンタ
                                
                                ;==============================================================
                                ; key input scan buffer
                                ; 末尾1バイトのアドレスが00であることを期待している。
                                ;==============================================================
       EE00                         ORG KEYBOARD_SCAN_BUFFER
                                
       EE00                     PORT_INDEX: DS 16
                                
       EE10                     enddat  EQU $           ; end of data area
       0241                     datsiz  EQU $-begdat    ; size of data area
                                
                                    END
[EOF:bios.z80:UTF_8]
