
;==============================================================
; BIOS of CP/M-80 ver2.2 for SORD M23 ver.20260610
;	The creator of the machine-dependent part is tsunozemi@twitter
;	Display and keyboard drivers are added by tsunozemi@twitter 2026/05/23
;==============================================================

msize	EQU	58	;cp/m version memory size in kilobytes

;
;	"bias" is address offset from 3400h for memory systems
;	than 16k (referred to as"b" throughout the text)
;
bias	EQU	(MSIZE-20)*1024
ccp		EQU	3400H+BIAS	;base of ccp
bdos	EQU	CCP+806H	;base of bdos
bios	EQU	CCP+1600H	;base of bios
cdisk	EQU	0004H	;current disk number 0=a,... l5=p
iobyte	EQU	0003H	;intel i/o byte

;=======================
;
; FDC I/O ports
;
;=======================
FDC_COMMAND_REG EQU 0C0H
FDC_STATUS_REG 	EQU FDC_COMMAND_REG
FDC_TRACK_REG 	EQU 0C1H
FDC_SECTOR_REG 	EQU 0C2H
FDC_DATA_REG 	EQU 0C3H
DMA_ADDRESS 	EQU 0C4H
FDC_CONTROL_REG EQU 0C5H
DMA_BANK_SEL 	EQU 0C6H

;=======================
;
; WBOOT Transfer Address
;
;=======================
WBOOT_ADDRESS_L EQU wboot_address
WBOOT_ADDRESS_H EQU WBOOT_ADDRESS_L + 1H

;=======================
;
; CRTC ports
;
;=======================
VRAM_TXT_TOP EQU 0F800H
VRAM_ATR_TOP EQU 0F000H
CRTC_ADDRESS_PORT EQU 0F0H
CRTC_VALUE_PORT EQU 0F1H
WIDTH_SCREEN EQU 50H ; 80文字モードの1行のバイト数
CURSOR_XY_ADDR EQU 0FFF0H ; カーソルのX,Y座標を保存するアドレス


;=======================
;
; Ascii code Constants
;
;=======================
CR	EQU	0DH ; Carriage Return
LF	EQU	0AH ; Line Feed
BS	EQU	08H ; Back Space
DEL	EQU	7FH ; Delete
HT  EQU 09H ; Horizontal Tab
VT  EQU 0BH ; Vertical Tab
BEL EQU 07H ; Bell
NP  EQU 0CH ; Formfeed (also: New page NP)
ESC EQU 1BH ; Escape



; Display Constants
NUMBER_OF_CHARACTER_AT_LINE	EQU 80 ; 1行の文字数
MAX_LINE  					EQU 24 ; 行数

; Keyboard scan buffer address
; キーボードスキャンの実装上、末尾のアドレスが00であることが条件になっている。
KEYBOARD_SCAN_BUFFER EQU 0EF00H ; バグのもと。いつか修正する。


; CTC Timer Initialization for CP/M
; Ch0を10ms周期のタイマーとして設定（IM2割り込み）

CTC_CH0     EQU 0FCh        ; CTC Ch0ポート
VEC_BASE    EQU 00h         ; CTCベクタベース
IM2_TABLE   EQU 0FF00h      ; IM2割り込みベクタテーブル
CTC_VEC_CH0 EQU 00h         ; Ch0のベクタオフセット

;==============================================================
; CP/M to host disk constants
;==============================================================
blksiz equ 2048	;CP/M allocation size
hstsiz equ 256	;host disk sector size
hstspt equ 16	;host disk sectors/trk
hstblk equ hstsiz/128	;CP/M sects/host buff
cpmspt equ hstblk * hstspt	;CP/M sectors/track
secmsk equ hstblk-1	;sector mask
;smask	hstblk	;compute sector mask
secshf equ 1	;log2(hstblk)

;==============================================================
; BDOS constants on entry to write
;==============================================================
wrall equ 0	;write to allocated
wrdir equ 1	;write to directory
wrual equ 2	;write to unallocated

		ORG	BIOS	;origin of this program
nsects	EQU	($-CCP)/128	;warm start sector count
;
;	jump vector for individual subroutines
;
		JP	boot	;cold start
wboote:	JP	wboot	;warm start
		JP	const	;console status
		JP	conin	;console character in
		JP	conout	;console character out
		JP	list	;list character out
		JP	punch	;punch character out
		JP	reader	;reader character out
		JP	home	;move head to home position
		JP	seldsk	;select disk
		JP	settrk	;set track number
		JP	setsec	;set sector number
		JP	setdma	;set dma address
		JP	read	;read disk
		JP	write	;write disk
		JP	listst	;return list status
		JP	sectran	;sector translate

;
;	fixed data tables for four-drive standard
;	ibm-compatible 8" disks
;
;	disk Parameter header for disk 00
dpbase:	dw	0h, 0000h
		dw	0000h, 0000h
		dw	dirbf, dpblk
		dw	chk00, all00
;	disk parameter header for disk 01
		dw	0h, 0000h
		dw	0000h, 0000h
		dw	dirbf, dpblk
		dw	chk01, all01
;	disk parameter header for disk 02
		dw	0h, 0000h
		dw	0000h, 0000h
		dw	dirbf, dpblk
		dw	chk02, all02
;	disk parameter header for disk 03
		dw	0h, 0000h
		dw	0000h, 0000h
		dw	dirbf, dpblk
		dw	chk03, all03

;
; SORD M23 1DD 80 track, 256 byte/sector, 16 sector, 1 side, 2048 byte/data block
;
;
dpblk:	;DISK PARM BLOCK
		DW	32		;SEC PER TRACK(by CP/M logical sector(128byte))
		DB	4		;BLOCK SHIFT
		DB	15		;BLOCK MASK
		DB	1		;EXTNT MASK
		DW	155		;DISK SIZE-1
		DW	63		;DIRECTORY MAX
		DB	128		;ALLOC0
		DB	0		;ALLOC1
		DW	16		;CHECK SIZE
		DW	2		;OFFSET
;
;	end of fixed tables
;

;	individual subroutines to perform each function
boot:	;simplest case is to just perform parameter initialization
		XOR	A	;zero in the accum
		LD	(iobyte),A	;clear the iobyte
		LD	(cdisk),A	;select disk zero
		LD	(hstact),A	;host buffer inactive
		LD	(unacnt),A	;clear unalloc count
;
		CALL CTC_INIT	; CTCの初期化
		CALL CRT_INIT	; CRT初期化
		CALL FDC_INIT	; FDC初期化
		CALL KBD_INIT	; キーボード初期化
;
		PUSH AF
		PUSH HL
		LD HL,OPENMSG
		CALL STRING_OUT
		POP HL
		POP AF

		JP	gocpm	;initialize and go to cp/m

;==============================================================
; worm boot process
;==============================================================
wboot:	;simplest case is to read the disk until all sectors loaded

		; WBOOTでは、CPPとBDOSをディスクから再ロードする。
		; BIOSはロードしない（すると壊れる）。

		LD	SP, 80h	;use space below buffer for stack
		LD	C, 0	;select disk 0
		CALL	seldsk


		; FDC initialize
		LD A,51H
		LD (FDC_CONTROL_REG),A

		; DMA Bank Selectを0に設定
		XOR A ; A=0
		OUT (DMA_BANK_SEL), A

		; DMAの転送アドレスを58k memory modelにおけるccpのアドレス(CC00H)にセットする。

		LD A,0CCH ; CC00Hは58K memory model
		LD (WBOOT_ADDRESS_H),A
		LD A,00H
		LD (WBOOT_ADDRESS_L),A
		;
		; 1st READ
		; 現在は、トラック22、セクタ9～16からトラック23、セクタ1～14という
		; 中途半端な位置にCPM.SYSを配置している。
		LD E,22 ; TARGET TRACK is No.22
DO_SEEK_WBOOT0:
		CALL SEEK
		JR Z,GO_DMA_WBOOT0
		JR DO_SEEK_WBOOT0
GO_DMA_WBOOT0:
		LD B,08 ; LOOP COUNT is 8 sectors
		LD C,09 ; INITIAL SECTOR NO. is 9 to 16 sector reading
;
READ_LOOP_WBOOT0:
		CALL GO_DMA_AND_READ_WBOOT0
		INC C
		LD A,(WBOOT_ADDRESS_H) ; memory address of DMA transfer address
		INC A ; 256 byte incriment
		LD (WBOOT_ADDRESS_H),A
		DJNZ READ_LOOP_WBOOT0

		;
		; 2nd READ
		;
		LD E,23  ; TARGET TRACK No.23
DO_SEEK_WBOOT1:
		CALL SEEK
		JR Z,GO_DMA_WBOOT1
		JR DO_SEEK_WBOOT1
GO_DMA_WBOOT1:
		LD B,014 ; LOOP COUNT is 14 sectors
		LD C,01 ; INITIAL SECTOR NO. is 1 to 14 sector reading
;
READ_LOOP_WBOOT1:
		CALL GO_DMA_AND_READ_WBOOT0
		INC C
		LD A,(WBOOT_ADDRESS_H) ; memory address of DMA transfer address
		INC A ; 256 byte incriment
		LD (WBOOT_ADDRESS_H),A
		DJNZ READ_LOOP_WBOOT1

		JP gocpm ; CP/Mを再起動

;==============================================================
; cpm go
;==============================================================
gocpm:
		LD	A, 0c3h	;c3 is a jmp instruction
		LD	(0),A	;for jmp to wboot
		LD	HL, wboote	;wboot entry point
		LD	(1),HL	;set address field for jmp at 0
;
		LD	(5),A	;for jmp to bdos
		LD	HL, bdos	;bdos entry point
		LD	(6),HL	;address field of Jump at 5 to bdos
;
		LD	BC, 80h	;default dma address is 80h
		CALL	setdma
		EI	;enable the interrupt system
		LD	A,(cdisk)	;get current disk number
		LD	C, A	;send to the ccp
		JP	ccp	;go to cp/m for further processing
;
;
;	simple i/o handlers (must be filled in by user)
;	in each case, the entry point is provided, with space reserved
;	to insert your own code
;
const:	;console status, return 0ffh if character ready, 00h if not
		LD A,0H ; no character ready
		RET
;
conin:	;console character into register a
		PUSH DE
		PUSH IX
		; ; コントロールコード処理
		; CALL DO_CONTROL_CODE
		; ; ESCシーケンス処理
		; CALL DO_ESC_SEQUENCE
		CALL KEY_SCAN_WRAPPER
		POP IX
		POP DE
		RET
;
conout:	;console character output from register c
		DI		;[[[[disable interrupts 20251230]]]]
		PUSH AF
		PUSH BC
		PUSH DE
		PUSH HL
		CALL CONOUT_PROCESS
		POP HL
		POP DE
		POP BC
		POP AF
		EI		;[[[[enable interrupts 20251230]]]]
		RET
;
list:	;list character from register c
		LD	A, C	;character to register a
		RET	;null subroutine
;
listst:	;return list status (0 if not ready, 1 if ready)
		XOR	A	;0 is always ok to return
		RET
;
punch:	;punch	character from	register C
		LD	A, C	;character to register a
		RET	;null subroutine
;
;
reader:	;reader character into register a from reader device
		LD	A, 1ah	;enter end of file for now (replace later)
		AND	7fh	;remember to strip parity bit
		RET
;
;
;	i/o drivers for the disk follow
;	for now, we will simply store the parameters away for use
;	in the read and write	subroutines
;
home:	;move to the track 00	position of current drive
;	translate this call into a settrk call with Parameter 00
		LD	A,(hstwrt)	;check for pending write
		OR	A
		JP	NZ,homed
		LD	(hstact),A	;clear host active flag
homed:
		RET	;we will move to 00 on first read/write
;
seldsk:	;select disk given by register c
		LD	HL, 0000h	;error return code
		LD	A, C
		LD	(sekdsk),A
		CP	4	;must be between 0 and 3
		RET	NC	;no carry if 4, 5,...
;	disk number is in the proper range
;		DS	10	;space for disk select
;		LD 
;	compute proper disk Parameter header address
		LD	A,(diskno)
		LD	L, A	;l=disk number 0, 1, 2, 3
		LD	H, 0	;high order zero
		ADD	HL,HL	;*2
		ADD	HL,HL	;*4
		ADD	HL,HL	;*8
		ADD	HL,HL	;*16 (size of each header)
		LD	DE, dpbase ;base of parm block
		ADD	HL,DE	;hl=,dpbase (diskno*16)(curdsk)
		RET
;
settrk:
	;set track given by registers BC
		LD	H,B
		LD	L,C
		LD	(sektrk),HL	;track to seek
		RET
;
setsec:	;set sector given by register c
		LD	A, C
		LD	(seksec),A
		RET
;
;
sectran:
	;translate the sector given by bc using the
	;translate table given by de
	;translate sector number BC
		LD	H,B
		LD	L,C
		RET

;
setdma:	;set	dma address given by registers b and c
		LD	L, C	;low order address
		LD	H, B	;high order address
		LD	(dmaadr),HL	;save the address
		RET

;==============================================================
; The READ entry point takes the place of
; the previous BIOS defintion for READ.
;==============================================================
read:	;perform read operation (usually this is similar to write
		;	so we will allow space to set up read command, then use
		;	common code in write)
	;read the selected CP/M sector
		XOR	A
		LD	(unacnt),A
		LD	A,1
		LD	(readop),A	;read operation
		LD	(rsflag),A	;must read data
		LD	A,wrual
		LD	(wrtype),A	;treat as unalloc
		JP	rwoper	;to perform the read

;==============================================================
; The WRITE entry point takes the place of
; the previous BIOS defintion for WRITE.
;==============================================================
write:
	;write the selected CP/M sector
		XOR	A	;0 to accumulator
		LD	(readop),A	;not a read operation
		LD	A,C	;write type in c
		LD	(wrtype),A
		CP	wrual	;write unallocated?
		JP	NZ,chkuna	;check for unalloc
;
;	write to unallocated, set parameters
		LD	A,blksiz/128	;next unalloc recs
		LD	(unacnt),A
		LD	A,(sekdsk)	;disk to seek
		LD	(unadsk),A	;unadsk = sekdsk
		LD	HL,(sektrk)
		LD	(unatrk),HL	;unatrk = sectrk
		LD	A,(seksec)
		LD	(unasec),A	;unasec = seksec
;
chkuna:
	;check for write to unallocated sector
		LD	A,(unacnt)	;any unalloc remain?
		OR	A
		JP	Z,alloc	;skip if not
;
;	more unallocated records remain
		DEC	A	;unacnt = unacnt-1
		LD	(unacnt),A
		LD	A,(sekdsk)	;same disk?
		LD	HL,unadsk
		CP	(HL)	;sekdsk = unadsk?
		JP	NZ,alloc	;skip if not
;
;	disks are the same
		LD	HL,unatrk
		CALL	sektrkcmp	;sektrk = unatrk?
		JP	NZ,alloc	;skip if not
;
;	tracks are the same
		LD	A,(seksec)	;same sector?
		LD	HL,unasec
		CP	(HL)	;seksec = unasec?
		JP	NZ,alloc	;skip if not
;
;	match, move to next sector for future ref
		INC	(HL)	;unasec = unasec+1
		LD	A,(HL)	;end of track?
		CP	cpmspt	;count CP/M sectors
		JP	C,noovf	;skip if no overflow
;
;	overflow to next track
		LD	(HL),0	;unasec = 0
		LD	HL,(unatrk)
		INC	HL
		LD	(unatrk),HL	;unatrk = unatrk+1
;
noovf:
	;match found, mark as unnecessary read
		XOR	A	;0 to accumulator
		LD	(rsflag),A	;rsflag = 0
		JP	rwoper	;to perform the write
;
alloc:
	;not an unallocated record, requires pre-read
		XOR	A	;0 to accum
		LD	(unacnt),A	;unacnt = 0
		INC	A	;1 to accum
		LD	(rsflag),A	;rsflag = 1

;==============================================================
; Common code for READ and WRITE follows
; Modified Interrupt Handling 20251230 by tsunozemi
;==============================================================
rwoper:
	;enter here to perform the read/write
		XOR	A	;zero to accum
		LD	(erflag),A	;no errors (yet)
		LD	A,(seksec)	;compute host sector
		OR	A	;carry = 0
		RRA		;shift right
		LD	(sekhst),A	;host sector to seek ; sekhst = seksec/2
;
;	active host sector?
		LD	HL,hstact	;host active flag
		LD	A,(HL)
		LD	(HL),1	;always becomes 1
		OR	A		;was it already?
		JP	Z,filhst	;fill host if not
;
;	host buffer active, same as seek buffer?
		LD	A,(sekdsk)
		LD	HL,hstdsk	;same disk?
		CP	(HL)		;sekdsk = hstdsk?
		JP	NZ,nomatch
;
;	same disk, same track?
		LD	HL,hsttrk
		CALL sektrkcmp	;sektrk = hsttrk?
		JP	NZ,nomatch
;
;	same disk, same track, same buffer?
		LD	A,(sekhst)
		LD	HL,hstsec	;sekhst = hstsec?
		CP	(HL)
		JP	Z,match	;skip if match
;
nomatch:
	;proper disk, but not correct sector
		LD	A,(hstwrt)		;host written?
		OR	A
		CALL NZ,writehst	;clear host buff
;
filhst:
	;may have to fill the host buffer
		LD	A,(sekdsk)
		LD	(hstdsk),A
		LD	HL,(sektrk)
		LD	(hsttrk),HL
		LD	A,(sekhst) ; sekhst -> hstsec
		LD	(hstsec),A
		LD	A,(rsflag)	;need to read?
		OR	A
		CALL NZ,readhst	;yes, if 1
		XOR	A			;0 to accum
		LD	(hstwrt),A	;no pending write
;
match:
	;copy data to or from buffer
		LD	A,(seksec)	;mask buffer number
		AND	secmsk		;least signif bits
		LD	L,A			;ready to shift
		LD	H,0			;double count
		ADD	HL,HL
		ADD	HL,HL
		ADD	HL,HL
		ADD	HL,HL
		ADD	HL,HL
		ADD	HL,HL
		ADD	HL,HL
;	hl has relative host buffer address
		LD	DE,hstbuf
		ADD	HL,DE		;hl = host address
		EX	DE,HL		;now in DE
		LD	HL,(dmaadr)	;get/put CP/M data
		LD	C,80H		;length of move
		LD	A,(readop)	;which way?
		OR	A
		JP	NZ,rwmove	;skip if read
;
;	write operation, mark and switch direction
		LD	A,1
		LD	(hstwrt),A	;hstwrt = 1
		EX	DE,HL	;source/dest swap
;
rwmove:
	;C initially 128(80H), DE is source, HL is dest
		LD	A,(DE)	;source character
		INC	DE
		LD	(HL),A	;to dest
		INC	HL
		DEC	C		;loop 128 times
		JP	NZ,rwmove
;
;	data has been moved to/from host buffer
		LD	A,(wrtype)	;write type
		CP	wrdir		;to directory?
		LD	A,(erflag)	;in case of errors
		RET	NZ			;no further processing
;
;	clear host buffer for directory write
		OR	A	;errors?
		RET	NZ	;skip if so
		XOR	A	;0 to accum
		LD	(hstwrt),A	;buffer written
		CALL	writehst
		LD	A,(erflag)
		RET

;==============================================================
; Utility subroutine for 16-bit compare
;==============================================================
sektrkcmp:
	;HL = .unatrk or .hsttrk, compare with sektrk
		EX	DE,HL
		LD	HL,sektrk
		LD	A,(DE)	;low byte compare
		CP	(HL)	;same?
		RET	NZ	;return if not
;	low bytes equal, test high 1s
		INC	DE
		INC	HL
		LD	A,(DE)
		CP	(HL)	;sets flags
		RET

;==============================================================
; WRITEHST performs the physical write to
;	the host disk, READHST reads the physical
;	disk.
;==============================================================
writehst:
	;hstdsk = host disk #, hsttrk = host track #,
	;hstsec = host sect #. write "hstsiz" bytes
	;from hstbuf and return error flag in erflag.
	;return erflag non-zero if error

		DI		;[[[[disable interrupts 20251230]]]]

		LD A,(hsttrk)
		LD E,A ; E is Track No.
		CALL SEEK
		LD A,(hstsec)
		ADD A,01H
		LD C,A ; C is Sector No.
		CALL GO_DMA_AND_WRITE0
		LD (erflag),A

		EI		;[[[[enable interrupts 20251230]]]]

		RET
;
readhst:
	;hstdsk = host disk #, hsttrk = host track #,
	;hstsec = host sect #. read "hstsiz" bytes
	;into hstbuf and return error flag in erflag.

		DI		;[[[[disable interrupts 20251230]]]]

		LD A,(hsttrk)
		LD E,A ; E is Track No.
		CALL SEEK
		LD A,(hstsec)
		ADD A,01H
		LD C,A ; C is Sector No.
		CALL GO_DMA_AND_READ0
		LD (erflag),A

		EI		;[[[[enable interrupts 20251230]]]]

		RET
;
; FDC COMMAND OUT subroutine
;
FDCOUT:
	OUT (FDC_COMMAND_REG),A
	LD A,30H
WLOOP: DEC A
	JR NZ,WLOOP
LOOP2:
	IN A,(FDC_STATUS_REG)
	BIT 0H,A ; BUSY IS CLEAR?
	JR NZ,LOOP2
	RET
;
; RESTORE subroutine
;
RESTORE:
RESTORE_LOOP:
	LD A,0BH ; restore command. 15ms, Head load, Verify OFF
	CALL FDCOUT
	BIT 7,A ; Not Ready?
	JR NZ,RESTORE_LOOP
	AND 98H
	JR NZ,RESTORE
	RET
;
; SEEK subroutine
; E is Track No.
;
SEEK:
	LD A,E ; E is Track No.
	OUT (FDC_DATA_REG),A
	LD A,1BH  ; seek command. 15ms, Head Load, Verify OFF
	CALL FDCOUT
	AND 98H
	RET
;
; DMA setting & Go
; HL is Address of DMA Command chain
;		but top value is No of DMA Command chain
DMA_ON:
	PUSH HL
	PUSH BC
	LD B,(HL)
	INC HL
	LD C,DMA_ADDRESS
	OTIR
	POP BC
	POP HL
	RET
;
; DMA setting & FDD read FOR SIDE 0
; C is Sector No.
;
GO_DMA_AND_READ0:
	LD A,C
	OUT (FDC_SECTOR_REG),A
READ0_RETRY:
	LD HL,DMA_COMMANDS
	CALL DMA_ON
	LD A,80H ; READ DATA COMMAND for Side 0
DO_FDC0:
	CALL FDCOUT

	PUSH AF
	LD A,83H
	OUT (DMA_ADDRESS),A
	POP AF

	AND 03CH
	JR Z, READ0_SUCCESS
	JR READ0_RETRY
READ0_SUCCESS:
	RET
;
; DMA setting & FDD write FOR SIDE 0
; C is Sector No.
;
GO_DMA_AND_WRITE0:
	LD A,C
	OUT (FDC_SECTOR_REG),A
	LD HL,DMA_WRITE_COMMANDS
	CALL DMA_ON
	LD A,0A0H ; WRITE DATA COMMAND for Side 0
DO_FDC_WR0:
	CALL FDCOUT
	AND 0FCH
	RET
;
; DMA setting & FDD read FOR WBOOT at SIDE 0
; C is Sector No.
;
GO_DMA_AND_READ_WBOOT0:
	LD A,C
	OUT (FDC_SECTOR_REG),A
	LD HL,DMA_WBOOT_COMMANDS
	CALL DMA_ON
	LD A,80H ; READ DATA COMMAND for Side 0
	CALL FDCOUT
	AND 03CH
	RET


;==============================================================
; SORD M23用CRTコントロールドライバ、キーボードドライバ
;==============================================================

;==============================================================
; FDC 初期化ルーチン
;==============================================================
FDC_INIT:
	LD A,51H
	LD (FDC_CONTROL_REG),A
	RET

;==============================================================
;
; キーボード初期化ルーチン
;
;==============================================================
KBD_INIT:
;
; キーボードスキャンバッファーを0で埋める。必要ないかも。
;
	LD HL,KEYBOARD_SCAN_BUFFER
	LD BC,10H
	LD A,0H
	LD (HL),A
	LD D,H
	LD E,L
	INC DE
	DEC BC
	LD A,B
	OR C
	RET Z
	LDIR
	RET

;==============================================================
;
; CRT 初期化ルーチン
;
;==============================================================;
CRT_INIT:
	LD HL,0F000H ; VRAMの左上のアトリビュートアドレス
	LD BC,0800H

; カーソル座標を00Hに設定する。
; 注：画面左上がカーソル座標では0000Hになる。VRAMにおけるテキスト画面左上(F800H)ではないことに注意。
	LD A,0EH ; R14 (cursor H)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,0H
	OUT (CRTC_VALUE_PORT),A
	LD A,0FH ; R15 (cursor L)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,00H
	OUT (CRTC_VALUE_PORT),A

; カーソルの形状と点滅の設定
	LD A,0AH ; R10 (CURSOR start address)
	OUT (CRTC_ADDRESS_PORT),A
;	LD A,C0H ; 点滅、豆腐カーソル
	LD A,C7H ; 点滅、アンスコカーソル
;	LD A,0H ; 表示せず。
	OUT (CRTC_VALUE_PORT),A
	LD A,0BH ; R11 (CURSOR end address)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,0AH
;	LD A,0H ; 表示せず。
	OUT (CRTC_VALUE_PORT),A

;
; 	一度画面全てを消す(スペースで埋める)。
;
	LD B,050H
	LD DE,0FFFFH
	LD A,20H ; 20Hはアスキーコードでスペース
CLEAR_LOOP:
	OUT (VRAM_BANK_PORT),A ; D2Hポートになにか書くと次の命令は別のページ(この場合はVRAMのページ)に行う。
	LD (HL),A ; F000H～FFFFHまで20Hで埋めている。アトリビュートに20H書いても問題ないみたい。
	INC HL
	SBC HL,DE
	JR NZ,CLEAR_LOOP

	XOR A
	LD DE, VRAM_TXT_TOP ; 最初の文字列表示位置(左上隅)
	LD (CURSOR_X),A ; カーソルのX座標を0にする
	LD (CURSOR_Y),A ; カーソルのY座標を0にする


	RET ; 初期化処理終了


;==============================================================
;
; SORD M23 CP/M ディスプレイドライバ
; CPU:  Z80
; CRTC: HD46505 (MC6845)
; テキストモード: 80桁 × 25行
;
;==============================================================
;
; [提供サブルーチン一覧]
;
;   GET_VRAM_ADDRESS_FROM_X_Y  … (X,Y) → VRAM アドレス
;   GET_X_Y_FROM_VRAM_ADDRESS  … VRAM アドレス → (X,Y)
;   SCROLL_UP                  … 画面を 1行上スクロール
;   WRITE_CHAR_AT_XY           … (X,Y) の位置に 1文字書き込む
;
;==============================================================
;===============================
; 定数 ― I/O ポート
;===============================
VRAM_BANK_PORT      EQU 0D2H    ; VRAMバンク切替ポート
                                ;   → このポートに書くと【次の1命令】が
                                ;     VRAM ページへのアクセスになる
;===============================
;
; 定数 ― HD46505 レジスタ番号
;
;===============================
CRTC_R12_START_H    EQU 0CH     ; Start Address High  (画面先頭アドレス上位)
CRTC_R13_START_L    EQU 0DH     ; Start Address Low   (画面先頭アドレス下位)
CRTC_R14_CURSOR_H   EQU 0EH     ; Cursor Address High
CRTC_R15_CURSOR_L   EQU 0FH     ; Cursor Address Low
;===============================
;
; データ領域
;
;===============================

;===============================
;
; CURRENT_TOP_LEFT_ADDRESS  (2 バイト)
;
; 現在の画面左上端の VRAM 絶対アドレス。
; 初期値 = F800H。
; スクロールのたびに +80 進み、FFFFH を超えると
; 旧コードの算法で F800H 付近へ折り返す。
;
; TLA は常に 16 の倍数のオフセットを持つ:
;   F800H, F810H, F820H, ..., FFFOH の 128 種類が循環する。
;   (GCD(80, 2048) = 16 より)
;------------------------------------------------------------
CURRENT_TOP_LEFT_ADDRESS:
    DW  VRAM_TXT_TOP        ; 初期値: F800H

;==============================================================
;
; GET_VRAM_ADDRESS_FROM_X_Y
;
; 仮想座標 (X, Y) から VRAM アドレスを計算する。
; VRAM リング (F800H-FFFFH = 2048 バイト) の折り返しを考慮。
;
; 入力:  B = Y 論理行 (0-24)   C = X 論理列 (0-79)
; 出力:  HL = VRAM アドレス
; 破壊:  A, DE
;
; 計算式:
;   offset  = Y × 80 + X              [0 ～ 1999]
;   raw     = TLA + offset             [16 ビット加算]
;
;   キャリーなし: VRAM = raw           (raw ∈ F800H..FFFFH)
;   キャリーあり: VRAM = raw + F800H   (raw = TLA+offset-10000H を
;                                       VRAM_TXT_TOP で補正)
;
; [Y × 80 の計算]
;   80 = 64 + 16 = 2^6 + 2^4
;   Y × 80 = Y×64 + Y×16
;   中間値 Y×16 を DE に保存し、Y×64 後に加算する。
;==============================================================
GET_VRAM_ADDRESS_FROM_X_Y:
    ;----------------------------------------------------------
    ; ① Y × 80 (シフト + 加算)
    ;----------------------------------------------------------
    LD  H, 0
    LD  L, B            ; HL = Y
    ADD HL, HL          ; HL = 2Y
    ADD HL, HL          ; HL = 4Y
    ADD HL, HL          ; HL = 8Y
    ADD HL, HL          ; HL = 16Y
    LD  D, H
    LD  E, L            ; DE = 16Y を保存
    ADD HL, HL          ; HL = 32Y
    ADD HL, HL          ; HL = 64Y
    ADD HL, DE          ; HL = 64Y + 16Y = 80Y

    ;----------------------------------------------------------
    ; ② X を加算 → offset (0 ～ 1999)
    ;----------------------------------------------------------
    LD  D, 0
    LD  E, C
    ADD HL, DE          ; HL = Y×80 + X

    ;----------------------------------------------------------
    ; ③ CURRENT_TOP_LEFT_ADDRESS (TLA) を加算
    ;----------------------------------------------------------
    LD  DE, (CURRENT_TOP_LEFT_ADDRESS)
    ADD HL, DE          ; HL = TLA + offset  [16 ビット加算]

    ;----------------------------------------------------------
    ; ④ VRAM リング折り返し補正
    ;
    ;   キャリーなし: HL ∈ [F800H, FFFFH] → そのまま返す
    ;   キャリーあり: HL = TLA + offset - 10000H  (∈ [0000H, ~07CEH])
    ;                 正しい VRAM = HL + F800H
    ;
    ;   例: TLA=F850H, Y=24, X=0 → offset=1920
    ;     F850H + 0780H = FFD0H (キャリーなし) → FFD0H ✓
    ;   例: TLA=FF80H, Y=24, X=0 → offset=1920
    ;     FF80H + 0780H = 10700H (キャリーあり) → HL=0700H
    ;     0700H + F800H = FF00H ✓
    ;----------------------------------------------------------
    RET NC                      ; キャリーなし → HL は有効 VRAM アドレス
    LD  DE, VRAM_TXT_TOP        ; F800H
    ADD HL, DE                  ; HL = (TLA + offset - 10000H) + F800H
    RET

;==============================================================
;
; GET_X_Y_FROM_VRAM_ADDRESS
;
; VRAM アドレスから仮想座標 (X, Y) を逆算する。
; (表示中の有効な VRAM アドレスを入力すること)
;
; 入力:  HL = VRAM アドレス
; 出力:  B = Y 論理行 (0-24)   C = X 論理列 (0-79)
; 破壊:  A, DE, HL
;
; 計算式:
;   CRTC_offset = (VRAM - TLA) mod 2048
;
;   VRAM >= TLA のとき: CRTC_offset = VRAM - TLA
;   VRAM <  TLA のとき: CRTC_offset = VRAM - TLA + 2048
;                                    = (VRAM - TLA + 10000H) - F800H
;
;   Y = CRTC_offset ÷ 80  (繰り返し減算、最大 24 回)
;   X = CRTC_offset mod 80
;
;   例: TLA=F850H, VRAM=FFD0H
;     FFD0H - F850H = 0780H = 1920 (キャリーなし)
;     Y = 24, X = 0 ✓
;   例: TLA=FF80H, VRAM=F800H
;     F800H - FF80H → ボロー → HL=F880H, +2048-補正:
;     F880H - F800H = 0080H = 128 (キャリーあり)
;     Y = 1, X = 48 ✓
;==============================================================
GET_X_Y_FROM_VRAM_ADDRESS:

    ;----------------------------------------------------------
    ; ① CRTC_offset = (VRAM - TLA) mod 2048
    ;----------------------------------------------------------
    LD  DE, (CURRENT_TOP_LEFT_ADDRESS)
    XOR A                       ; キャリークリア (かつ A=0)
    SBC HL, DE                  ; HL = VRAM - TLA

    JR  NC, GXYVA_OFFSET_OK     ; VRAM >= TLA: HL = CRTC_offset

    ; VRAM < TLA (リング折り返し):
    ;   HL = VRAM - TLA + 10000H  (∈ F801H..FFFFH)
    ;   CRTC_offset = HL - F800H  = VRAM - TLA + 800H
    ;
    ;   OR A で CY=0 を保証したうえで SBC することで
    ;   A の値を変えずに正確に F800H を引く。
    LD  DE, VRAM_TXT_TOP        ; F800H
    OR  A                       ; キャリークリア (A=0 のまま保持)
    SBC HL, DE                  ; HL = (VRAM - TLA + 10000H) - F800H
                                ;    = VRAM - TLA + 800H = CRTC_offset

GXYVA_OFFSET_OK:
    ; HL = CRTC_offset  (0 ～ 1999)

    ;----------------------------------------------------------
    ; ② CRTC_offset ÷ 80 → Y (商),  X (余り)
    ;    繰り返し減算: 最大 24 回のループで完了
    ;----------------------------------------------------------
    LD  B, 0                    ; Y カウンタ
GXYVA_DIV:
    LD  A, H
    OR  A
    JR  NZ, GXYVA_SUB          ; H ≠ 0 → HL ≧ 256 > 80 → まだ引ける
    LD  A, L
    CP  NUMBER_OF_CHARACTER_AT_LINE               ; L < 80 ?
    JR  C,  GXYVA_DONE         ; L < 80 → 除算完了
GXYVA_SUB:
    LD  A, L
    SUB NUMBER_OF_CHARACTER_AT_LINE               ; A = L - 80
    LD  L, A
    JR  NC, GXYVA_INC
    DEC H                       ; ボロー補正
GXYVA_INC:
    INC B                       ; Y++
    JR  GXYVA_DIV
GXYVA_DONE:
    LD  C, L                    ; C = X (余り = 論理列)
    ; B = Y (商 = 論理行) ← 出力確定
    RET

;==============================================================
;
; SCROLL_UP
;
; 画面を 1 行上スクロールする。
;
; [処理概要]
;   [1] CURRENT_TOP_LEFT_ADDRESS から 80 文字をスペースで消去
;       (FFFFH → F800H の境界越えを考慮)
;   [2] CURRENT_TOP_LEFT_ADDRESS を 80 進める
;       (境界越え時は旧コードの算法 + -2 補正)
;   [3] HD46505 R12/R13 に新 TLA を書き込む (絶対 VRAM アドレス)
;
; 入力:  なし
; 出力:  なし
; 破壊:  なし (AF, BC, DE, HL をすべて保存・復元)
;
; [TLA 進め方の算法 --- 境界越え時]
;   TLA + 50H > FFFFH のとき、旧コードの算法を用いる:
;     A      = FFFFH - TLA - 1  (CY=1 を受け取って SBC)
;     result = 50H - A - CY2    (CY2 は上記 SBC の繰り越し)
;     new_TLA = VRAM_TXT_TOP + result - 2
;   末尾の -2 はキャリー伝播に起因する算法固有の補正値。
;
;   例: TLA=FFD0H → new_TLA=F820H
;     FFFFH - FFD0H - 1 = 2EH
;     50H - 2EH = 22H
;     F800H + 22H - 2 = F820H ✓  (期待値: (2000+80) mod 2048 = 32 → F820H)
;==============================================================
SCROLL_UP:
    PUSH AF
    PUSH BC
    PUSH DE
    PUSH HL

    ;----------------------------------------------------------
    ; [1] 旧最上行 (TLA から 80 文字) をスペースで消去
    ;
    ;     1 文字書くたびに PUSH HL / OR A / SBC HL, FFFFH / POP HL で
    ;     HL = FFFFH かどうかを判定する (OR A で CY=0 を保証)。
    ;     FFFFH 書き込み後: DJNZ が未実行のため DEC B で補正してから
    ;     F800H へ折り返し、残り文字数分を書き続ける。
    ;----------------------------------------------------------
    LD  HL, (CURRENT_TOP_LEFT_ADDRESS)
    LD  DE, 0FFFFH          ; 境界判定用
    LD  B, NUMBER_OF_CHARACTER_AT_LINE        ; B = 80 (ループカウンタ)
    LD  A, 20H              ; スペース文字

SU_CLEAR:
	DI
    OUT (VRAM_BANK_PORT), A ; 次の命令 (LD(HL),A) を VRAM ページへ
    LD  (HL), A             ; VRAM にスペースを書き込む
	EI
    PUSH HL
    OR  A                   ; キャリークリア (OR A は A=20H を保持, CY=0 保証)
    SBC HL, DE              ; HL - FFFFH: Z=1 のとき HL=FFFFH
    POP HL
    JR  Z, SU_CLEAR_WRAP    ; FFFFH に達したら折り返し
    INC HL
SU_CLEAR_NEXT:
    DJNZ SU_CLEAR           ; B--、B≠0 ならループ
    JR  SU_CLEAR_DONE

SU_CLEAR_WRAP:
    ; FFFFH への書き込みは完了。この反復では DJNZ を実行していないため
    ; B をデクリメントして補正する。
    DEC B
    JR  Z, SU_CLEAR_DONE    ; B=0 → 80 文字消去完了
    LD  HL, VRAM_TXT_TOP    ; F800H へ折り返し
SU_CLEAR_WRAP_LOOP:
	DI
    OUT (VRAM_BANK_PORT), A
    LD  (HL), A
	EI
    INC HL
    DJNZ SU_CLEAR_WRAP_LOOP

SU_CLEAR_DONE:
    ;----------------------------------------------------------
    ; [2] CURRENT_TOP_LEFT_ADDRESS を NUMBER_OF_CHARACTER_AT_LINE (80) 進める
    ;----------------------------------------------------------
    LD  HL, (CURRENT_TOP_LEFT_ADDRESS)
    LD  DE, NUMBER_OF_CHARACTER_AT_LINE           ; 50H = 80
    ADD HL, DE                  ; HL = TLA + 80
    JR  NC, SU_UPDATE_TLA       ; オーバーフローなし → そのまま

    ; TLA + 80 > FFFFH の場合 (CY=1 を保持したまま以降の SBC へ渡す)
    LD  DE, 0FFFFH
    LD  HL, (CURRENT_TOP_LEFT_ADDRESS)  ; TLA を再ロード
    EX  DE, HL                  ; HL = FFFFH,  DE = TLA
    SBC HL, DE                  ; HL = FFFFH - TLA - 1  (CY=1 を使用)
    LD  DE, NUMBER_OF_CHARACTER_AT_LINE           ; 50H
    EX  DE, HL                  ; HL = 50H,  DE = (FFFFH - TLA - 1)
    SBC HL, DE                  ; HL = 50H - (FFFFH-TLA-1) - CY
    LD  DE, VRAM_TXT_TOP        ; F800H
    ADD HL, DE
    DEC HL                      ; -2 補正 (算法固有)
    DEC HL

SU_UPDATE_TLA:
    LD  (CURRENT_TOP_LEFT_ADDRESS), HL

    ;----------------------------------------------------------
    ; [3] HD46505 R12/R13 に新 TLA を書き込む
    ;     H → R12 (上位),  L → R13 (下位)
    ;     絶対 VRAM アドレスをそのまま書き込む (旧コードと同方式)
    ;----------------------------------------------------------
	DI
    LD  A, CRTC_R12_START_H
    OUT (CRTC_ADDRESS_PORT), A
    LD  A, H
    OUT (CRTC_VALUE_PORT), A
    LD  A, CRTC_R13_START_L
    OUT (CRTC_ADDRESS_PORT), A
    LD  A, L
    OUT (CRTC_VALUE_PORT), A
	EI

    POP HL
    POP DE
    POP BC
    POP AF
    RET

;==============================================================
;
; WRITE_CHAR_AT_X_Y
;
; 仮想座標 (X, Y) の位置に 1文字を VRAM へ書き込む。
; カーソル位置は変更しない。
;
; 入力:	B = Y 論理行 (0-24)
;		C = X 論理列 (0-79)
;      	A = 書き込む文字コード
; 出力:  なし
; 破壊:  A, DE, HL
;         (BC は GET_VRAM_ADDRESS_FROM_X_Y が保存するため変化なし)
;
; 【カーソル表示との連携について】
;   本ルーチンは VRAM への文字書き込みのみ行う。
;   画面上のカーソル位置を更新したい場合は、呼び出し側が
;   CURRENT_CURSOR_LOCATE を更新したうえで PRINT_CURSOR を呼ぶこと。
;
;==============================================================
WRITE_CHAR_AT_X_Y:
    ;----------------------------------------------------------
    ; GET_VRAM_ADDRESS_FROM_X_Y は A を破壊するため、
    ; 書き込む文字コードを PUSH AF でスタックに退避する。
    ; CALL 後に POP AF で復元してから VRAM へ書き込む。
    ;----------------------------------------------------------
    PUSH AF                         ; 文字コード (A) を退避
    CALL GET_VRAM_ADDRESS_FROM_X_Y  ; HL = VRAM アドレス  (A, DE 破壊)
    POP  AF                         ; A = 文字コード を復元
	DI
    OUT  (VRAM_BANK_PORT), A        ; 次の命令 (LD(HL),A) を VRAM ページへ
    LD   (HL), A                    ; VRAM に文字を書き込む
	EI
    RET
;==============================================================
;
; CONOUT_PROCESS  (CP/M BIOS コンソール出力)
;
; CP/M BIOS インターフェース:
;   C = 出力文字コード
;
; 破壊: なし (AF, BC, DE, HL をすべて保存・復元)
;
; 制御コード処理:
;   0AH (LF) : X = 0 (行頭へ)、Y 変化なし
;   0DH (CR) : Y += 1 (次行へ)、X 変化なし
;              Y = 24 (最下行) の場合は SCROLL_UP を呼び Y を 24 に維持
;   20H 未満の他の制御コード : 無視 (カーソル位置更新のみ)
;   20H 以上の印字文字       : 現在位置に書き込み後 X += 1
;              X = 80 (行末超え) の場合: X=0 にして CR 相当の処理
;
;==============================================================
CONOUT_PROCESS:
    PUSH AF
    PUSH BC
    PUSH DE
    PUSH HL

	LD A, C                    ; A = 出力文字コード

    ;----------------------------------------------------------
    ; 制御コード分岐
    ;----------------------------------------------------------
	CP  BEL
	JP  Z, CO_BEL   ; BEL (07H): 無視
	CP  HT
	JP  Z, CO_HT    ; 水平タブ
    CP  LF
    JP  Z, CO_LF    ; LF (0AH): X=0、Y 変化なし
    CP  VT
    JP  Z, CO_VT    ; 垂直タブ
    CP  NP
    JP  Z, CO_FF    ; NewPage = フォームフィード(FF)
    CP  CR
    JP  Z, CO_CR    ; CR (0DH): Y+1 (最下行ならスクロール)
	CP  BS
	JP  Z, CO_BS    ; BS (08H): バックスペース
    CP  20H
    JP  C, CO_CURSOR_UPDATE    ; 00H-19H のその他の制御コード: 無視

    ;----------------------------------------------------------
    ; 印字可能文字 (20H 以上)
    ;
    ; WRITE_CHAR_AT_X_Y は A, DE, HL を破壊するため
    ; 文字コードを D に退避してから呼ぶ
    ;----------------------------------------------------------
    LD  D, A                    ; D = 文字コードを退避
    LD  A, (CURSOR_Y)
    LD  B, A                    ; B = Y
    LD  A, (CURSOR_X)
    LD  C, A                    ; C = X
    LD  A, D                    ; A = 文字コードを復元
    CALL WRITE_CHAR_AT_X_Y      ; (X,Y) の位置に文字を書き込む

    ; X を進める
    LD  A, (CURSOR_X)
    INC A
    CP  80                      ; X = 80 (行末超え)?
    JR  C, CO_SAVE_X            ; X < 80: そのまま保存してカーソル更新へ
    ; 行末折り返し: X=0 にして CR 相当の処理 (Y+1 またはスクロール) へ
    XOR A
    LD  (CURSOR_X), A
    JR  CO_CR

CO_SAVE_X:
    LD  (CURSOR_X), A
    JP  CO_CURSOR_UPDATE

    ;----------------------------------------------------------
    ; LF (0AH): X = 0、Y 変化なし
    ;----------------------------------------------------------
CO_LF:
    XOR A
    LD  (CURSOR_X), A
    JP  CO_CURSOR_UPDATE

    ;----------------------------------------------------------
    ; CR (0DH): Y += 1、X = 0 ; S-OSのCRはCR+LFの動作なので、CRのときはLFの処理も行う
    ; ※ 行末折り返し (X=80) のときもここに合流する
    ;----------------------------------------------------------
CO_CR:
    LD  A, (CURSOR_Y)
    CP  24                      ; 最下行 (Y=24)?
    JP  Z, CO_SCROLL            ; Yes → スクロール (Y は 24 のまま)
    INC A
    LD  (CURSOR_Y), A
	; S-OSのCRはCR+LFの動作なので、CRのときはLFの処理も行う
    XOR A
    LD  (CURSOR_X), A
	;
    JR  CO_CURSOR_UPDATE

	;----------------------------------------------------------
    ; CO_BS  バックスペース (08H)
    ;
    ; カーソルを 1 つ戻し、その位置をスペースで消去する。
    ;
    ; 処理:
    ;   X > 0          : X -= 1
    ;   X = 0, Y > 0   : X = 79, Y -= 1  (前行末へ折り返し)
    ;   X = 0, Y = 0   : 何もしない (画面左上端、戻れない)
    ;----------------------------------------------------------
CO_BS:
    LD  A, (CURSOR_X)
    OR  A                       ; X = 0?
    JR  NZ, CO_BS_DEC_X        ; No → X を 1 減らすだけ

    ; X = 0 のとき
    LD  A, (CURSOR_Y)
    OR  A                       ; Y = 0?
    JR  Z, CO_BS_IGNORE        ; Yes → 左上端、何もしない

    ; X=0, Y>0: 前行末 (X=79, Y-1) へ
    DEC A
    LD  (CURSOR_Y), A           ; Y -= 1
    LD  A, 79
    LD  (CURSOR_X), A           ; X = 79
    JR  CO_BS_ERASE

CO_BS_DEC_X:
    DEC A
    LD  (CURSOR_X), A           ; X -= 1

    ;----------------------------------------------------------
    ; 戻った位置をスペース (20H) で消去
    ; 参考コードの OUT(D2H)+LD(DE),A に相当する処理を
    ; WRITE_CHAR_AT_X_Y 経由で行う
    ;----------------------------------------------------------
CO_BS_ERASE:
    LD  A, (CURSOR_Y)
    LD  B, A                    ; B = Y
    LD  A, (CURSOR_X)
    LD  C, A                    ; C = X
    LD  A, 20H                  ; A = スペース
    CALL WRITE_CHAR_AT_X_Y      ; (X,Y) の位置をスペースで消去

CO_BS_IGNORE:
    JP  CO_CURSOR_UPDATE        ; CONOUT の CO_CURSOR_UPDATE ラベルへ

;----------------------------------------------------------
    ; CO_HT  水平タブ (09H)  タブ幅 4
    ;
    ; 次の 4 の倍数列へ X を進める。
    ;
    ; タブストップ: X = 0, 4, 8, 12, ... , 76
    ;
    ; 計算式:
    ;   new_X = (CURSOR_X & FCH) + 4
    ;   ※ AND FCH で下 2 ビットをクリア(4 の倍数へ切り捨て)
    ;     → そこに 4 を加えて次のタブストップを得る
    ;
    ;   例: X=0  → (00H & FCH)+4 = 04H
    ;       X=3  → (00H & FCH)+4 = 04H
    ;       X=4  → (04H & FCH)+4 = 08H
    ;       X=77 → (4CH & FCH)+4 = 50H=80 → 行末超え → X=0 かつ CO_CR へ
    ;----------------------------------------------------------
CO_HT:
    LD  A, (CURSOR_X)
    AND 0FCH                    ; X を 4 の倍数に切り捨て
    ADD A, 4                    ; 次のタブストップ (4..80)
    CP  80                      ; 80 以上 (行末超え)?
    JR  C, CO_HT_SAVE           ; No → そのまま保存してカーソル更新へ
    ; 行末超え: X=0 にして CR 相当 (Y+1 またはスクロール) へ
    XOR A
    LD  (CURSOR_X), A
    JR  CO_CR                   ; CONOUT の CO_CR ラベルへ
CO_HT_SAVE:
    LD  (CURSOR_X), A
    JR  CO_CURSOR_UPDATE        ; CONOUT の CO_CURSOR_UPDATE ラベルへ


    ;----------------------------------------------------------
    ; CO_VT  垂直タブ (0BH)
    ;
    ; Y を 1 増やす。X は変化しない。
    ; 最下行 (Y=24) の場合は SCROLL_UP。
    ; → CR (0DH) と動作が同じなので CO_CR に合流する。
    ;----------------------------------------------------------
CO_VT:
    JR  CO_CR                   ; CONOUT の CO_CR ラベルへ

	;----------------------------------------------------------
    ; CO_FF  フォームフィード (0CH)
    ;
    ; 画面全消去 + カーソルを (0,0) へ。
    ;
    ; 処理内容:
    ;   [1] CURRENT_TOP_LEFT_ADDRESS を F800H にリセット
    ;   [2] HD46505 R12/R13 を F800H に戻す
    ;   [3] VRAM テキスト領域 (F800H-FFFFH, 2048 バイト) を
    ;       スペース (20H) で埋める
    ;       ※ 余り領域 (FFD0H-FFFFH, 48 バイト) も含めて全消去
    ;   [4] CURSOR_X, CURSOR_Y を 0 にリセット
    ;----------------------------------------------------------
CO_FF:
    ; [1] CURRENT_TOP_LEFT_ADDRESS を F800H にリセット
    LD  HL, VRAM_TXT_TOP
    LD  (CURRENT_TOP_LEFT_ADDRESS), HL

	DI
    ; [2] HD46505 R12/R13 を F800H に戻す (絶対アドレス)
    LD  A, CRTC_R12_START_H
    OUT (CRTC_ADDRESS_PORT), A
    LD  A, 0F8H                 ; F800H 上位
    OUT (CRTC_VALUE_PORT), A
    LD  A, CRTC_R13_START_L
    OUT (CRTC_ADDRESS_PORT), A
    XOR A                       ; F800H 下位 = 00H
    OUT (CRTC_VALUE_PORT), A
	EI

    ; [3] VRAM テキスト領域を全消去 (F800H-FFFFH = 2048 バイト)
    ;     2000 バイトではなく 2048 バイトを消去する。
    ;     余り領域 (FFD0H-FFFFH) をクリアしないと、
    ;     スクロール後にその 48 バイトが行頭に見えてしまうため。
    LD  HL, VRAM_TXT_TOP        ; HL = F800H
    ; LD  BC, VRAM_SIZE           ; BC = 0800H (2048 バイト)
    LD  BC, 0800H           ; BC = 0800H (2048 バイト)
CO_FF_CLEAR:
	DI
    LD  A, 20H
    OUT (VRAM_BANK_PORT), A     ; 次の命令を VRAM ページへ
    LD  (HL), A
	EI
    INC HL                      ; FFFFH の後は 0000H へ (16 ビット折り返し)
    DEC BC                      ; BC=0000H になったとき HL=0000H だが未使用
    LD  A, B
    OR  C
    JR  NZ, CO_FF_CLEAR

    ; [4] カーソルを (0,0) へ
    XOR A
    LD  (CURSOR_X), A
    LD  (CURSOR_Y), A
    JR  CO_CURSOR_UPDATE

CO_BEL:
	; BEL (07H): 無視
	JR  CO_CURSOR_UPDATE        ; カーソル位置は変わらないが、更新しておく

    ;----------------------------------------------------------
    ; スクロール
    ; CURSOR_Y は 24 のまま。SCROLL_UP が最下行をクリアする。
    ;----------------------------------------------------------
CO_SCROLL:
    CALL SCROLL_UP
    ; fall through

    ;----------------------------------------------------------
    ; ハードウェアカーソル更新
    ; (X,Y) → VRAM アドレス → CURRENT_CURSOR_LOCATE → PRINT_CURSOR
    ;----------------------------------------------------------
CO_CURSOR_UPDATE:
    LD  A, (CURSOR_Y)
    LD  B, A
    LD  A, (CURSOR_X)
    LD  C, A
    CALL GET_VRAM_ADDRESS_FROM_X_Y  ; HL = カーソル位置の VRAM アドレス
    LD  (CURRENT_CURSOR_LOCATE), HL
    CALL PRINT_CURSOR

    POP HL
    POP DE
    POP BC
    POP AF
    RET

;==============================================================
;
; PRINT_CURSOR
;
; カーソルをCURRENT_CURSOR_LOCATEの位置に表示する(HD46505Sの機能)
;
;==============================================================
PRINT_CURSOR:
	PUSH AF
	PUSH DE
	PUSH HL
	LD HL,(CURRENT_CURSOR_LOCATE) ; 現在のカーソル位置をHLにロード
	DI
	LD A,0EH ; R14 (cursor H)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,H
	OUT (CRTC_VALUE_PORT),A ; カーソルの上位アドレス設定
	LD A,0FH ; R15 (cursor L)
	OUT (CRTC_ADDRESS_PORT),A
	LD A,L
	OUT (CRTC_VALUE_PORT),A ; カーソルの下位アドレス設定
	EI
	POP HL
	POP DE
	POP AF
	RET

;==============================================================
;
; STRING_OUT
;
; 文字列をヌル終端 (00H) まで連続して VRAM へ書き込む。
; 1文字ごとに WRITE_CHAR_AT_XY を呼ぶ。
;
; 入力:
;   B  = Y  論理行 (0-24)
;   C  = X  論理列 (0-79)  ※表示開始列
;   HL = 文字列先頭アドレス
;
; 出力: なし
; 破壊: A, DE, HL
;         (BC は WRITE_CHAR_AT_XY が保存するため変化なし)
;
;==============================================================
STRING_OUT:
    LD   A, (HL)            ; 次の文字を読み出す
    OR   A                  ; ヌル終端 (00H) か?
    RET  Z                  ; 00H なら終了

    PUSH HL                 ; 文字列ポインタを退避
							; (WRITE_CHAR_AT_XY は HL を破壊するため)
    CALL WRITE_CHAR_AT_X_Y  ; B=Y, C=X, A=文字 → VRAM へ書き込む
    POP  HL                 ; 文字列ポインタを復元

    INC  HL                 ; 次の文字へ
    INC  C                  ; X を +1 (次の列へ)
    JR   STRING_OUT
;==============================================================
;
; データ領域 (CONOUT が使用)
;
;==============================================================
CURSOR_X:
    DB  0                   ; 現在のカーソル X 座標 (0-79)
CURSOR_Y:
    DB  0                   ; 現在のカーソル Y 座標 (0-24)
CURRENT_CURSOR_LOCATE:
    DW  F800H              ; カーソルの VRAM アドレス (PRINT_CURSOR が参照)


;=======================================================
;
; エスケープシーケンス処理
;
;=======================================================

; DO_ESC_SEQUENCE:
; 	LD A, (FLAG_ESC_SEQUENCE) ; エスケープシーケンスのフラグをチェック
; 	CP 1H
; 	JR Z, PROCESS_ESC_SEQUENCE ; フラグが立っているときはエスケープシーケンスの処理へ
; 	AND A
; 	JR Z, END_OF_ESC_SEQUENCE ;ESC\[の次の文字がないときは、エスケープシーケンスの処理をせずに戻る。
; 	CP ESC
; 	JP Z, SET_FLAG_ESC_SEQUENCE ; もし、次の文字もESCだったら、エスケープシーケンスのフラグを立てる。
; END_OF_ESC_SEQUENCE:
; 	RET

; SET_FLAG_ESC_SEQUENCE:
; 	; 現状、エスケープシーケンスは未実装。将来的にここで処理する。
; 	LD A,1 ; エスケープシーケンスのフラグを立てる
; 	LD (FLAG_ESC_SEQUENCE),A
; 	JP END_OF_ESC_SEQUENCE

; PROCESS_ESC_SEQUENCE:
; 	; エスケープシーケンスの処理。現状、未実装。
; 	; 将来的に、ここでエスケープシーケンスを処理する。

; 	LD A,0 ; エスケープシーケンスのフラグを下げる
; 	LD (FLAG_ESC_SEQUENCE),A
; 	JP END_OF_ESC_SEQUENCE


;========================================
;
; キー入力ルーチン
; KEY_SCAN_WRAPPERは、何かが押されているときにKEY_SCANを呼び出すルーチンです。
; 何も押されていないときはループしてキー入力を待ちます。
; 一回だけ、16個のキーマトリックスI/Oポートをスキャンしたい場合には、以下のようにKEY_SCANをコールします。
;
; 	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
;	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
;	CALL KEY_SCAN ; キースキャンを実行する。
;
;  KEY_SCANルーチン内で、DJNZを使って、16個のキーマトリックスI/Oポートをスキャンするため、BCレジスタに値が設定されていないと正しく動きません。
;
;========================================
KEY_SCAN_WRAPPER:
    PUSH HL
    PUSH BC
KEY_SCAN_WRAPPER_LOOP:
    LD HL, PORT_INDEX
    LD BC, 0FDFH
    CALL KEY_SCAN
    AND A
    JR Z, KEY_SCAN_WRAPPER_LOOP
    POP BC
    POP HL
    RET

KEY_SCAN:
    ; 前回の値を保存
    LD HL, PORT_INDEX
    LD DE, PREV_INDEX
    LD BC, 0010H
    LDIR

    ; 今回の値をスキャン（LDIRでBC=0になったので再設定）
    LD HL, PORT_INDEX
    LD BC, 0FDFH         ; ← これは既にある
SCAN_LOOP:
    INC C
    DI
    IN A,(C)
    EI
    LD (HL), A
    INC HL
    DJNZ SCAN_LOOP

    ; フラグをリセットせず、現在のPORT_INDEX[0]から直接更新
    LD A, (PORT_INDEX)
    AND 20H
    LD (SHIFT_FLAG), A   ; Shift押下中なら0x20、離れていれば0x00

    LD A, (PORT_INDEX)
    AND 10H
    LD (CTRL_FLAG), A    ; Ctrl押下中なら0x10、離れていれば0x00

    LD HL, PORT_INDEX
    LD D, 0H
    JR KEY_LOOP_1

SCAN_LOOP_RETURN:
    RET

KEY_LOOP_1:
    LD A, (HL)
    AND A
    JR Z, KEY_LOOP_1_NEXT

    ; エッジ検出
    LD E, A
    PUSH HL
    LD A, L
    ADD A, 12H
    LD L, A
    LD A, (HL)
    POP HL
    CPL
    AND E
    JR Z, KEY_LOOP_1_NEXT

    ; index[0]の場合はShift/Ctrl以外のビットがあるか確認するだけ
    LD A, D
    CP 00H
    JR NZ, KEY_LOOP_2_DISPATCH

    ; Shift/Ctrl以外のビット確認
    LD A, E
    AND 0CFH
    JR NZ, KEY_LOOP_2_DISPATCH

KEY_LOOP_1_NEXT:
    INC D
    INC HL
    LD A, D
    CP 10H
    JR Z, KEY_LOOP_NO_KEY
    JR KEY_LOOP_1

KEY_LOOP_NO_KEY:
    LD A, 0H
    JR SCAN_LOOP_RETURN

KEY_LOOP_2_DISPATCH:
    LD A, E
    JR KEY_LOOP_2


;
; 何かが押されている時に実行される。
;

KEY_LOOP_2:
    CP 04H
    JP Z, CODE_04
    CP 08H
    JP Z, CODE_08
    CP 10H
    JP Z, CODE_10
    CP 20H
    JP Z, CODE_20
    CP 40H
    JP Z, CODE_40
    LD A, 0H
    JR SCAN_LOOP_RETURN

;=======================================================
;
;  CODE 04 キーボードの1段目
;  (esc,1,2,3,4,5,6,7,8,9,0,-,=,bs)
;
;=======================================================
CODE_04:
    LD A, L
    AND 0FH
    CP 00H
    JP Z, CODE_ESC

    LD A, (SHIFT_FLAG)
    AND A
    JP NZ, CODE_04_SHIFT

    LD B, L
    LD IX, KEY_MAP
MAP_ADD_04:
    INC IX
    DJNZ MAP_ADD_04
    LD A, (IX+0)
    JP SCAN_LOOP_RETURN

CODE_08:
    LD A, L
    AND 0FH
    CP 00H
    JP Z, CODE_TAB
	CP 0DH              ; RETURNキーのオフセット確認
    JP Z, CODE_CR       ; ← 追加

    LD A, (SHIFT_FLAG)
    AND A
    JP NZ, CODE_08_SHIFT

    LD A, (CTRL_FLAG)
    AND A
    JP NZ, CODE_08_CONTROL

    LD B, L
    LD IX, KEY_MAP
MAP_ADD_08:
    INC IX
    DJNZ MAP_ADD_08
    LD A, (IX+10H)
    JP SCAN_LOOP_RETURN

CODE_10:
    LD A, L
    AND 0FH
    CP 00H
    JP Z, CODE_CTRL_KEY

    LD A, (SHIFT_FLAG)
    AND A
    JP NZ, CODE_10_SHIFT

    LD A, (CTRL_FLAG)
    AND A
    JP NZ, CODE_10_CONTROL

    LD B, L
    LD IX, KEY_MAP
MAP_ADD_10:
    INC IX
    DJNZ MAP_ADD_10
    LD A, (IX+20H)
    JP SCAN_LOOP_RETURN

CODE_20:
    LD A, L
    AND 0FH
    CP 00H
    JP Z, CODE_SHIFT_KEY

    LD A, (SHIFT_FLAG)
    AND A
    JP NZ, CODE_20_SHIFT

    LD A, (CTRL_FLAG)
    AND A
    JP NZ, CODE_20_CONTROL

    LD B, L
    LD IX, KEY_MAP
MAP_ADD_20:
    INC IX
    DJNZ MAP_ADD_20
    LD A, (IX+30H)
    JP SCAN_LOOP_RETURN

CODE_40:
    JP KEY_LOOP_END

CODE_SHIFT_KEY:
CODE_CTRL_KEY:
    LD A, 0H
    JP SCAN_LOOP_RETURN

KEY_LOOP_END:
    LD A, 0H
    JP SCAN_LOOP_RETURN

;
; 特殊キー(CONTROL,SHIFT, TAB)の処理
;

CODE_TAB:
    LD A, 09H
    JP SCAN_LOOP_RETURN

CODE_ESC:
    LD A, ESC
    JP SCAN_LOOP_RETURN

CODE_CR:
    LD A, 0DH
    JP SCAN_LOOP_RETURN

;=======================================================
;
; SHIFTキーと同時に押されたキーをゲットするサブルーチン
;
;=======================================================

SHIFT_KEY_NEXT_GET:
	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
SHIFT_SCAN_LOOP:
	INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
	DI
	IN A,(C)
	EI
	LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
	INC HL ; メモリアドレスをインクリメント。
	DJNZ SHIFT_SCAN_LOOP ; 16回繰り返す

	LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
	LD D,0H ; インデックスを 1 にする。
	LD B,0FH ; B=FH=16
	LD E,0H

;
; SHIFTキーを離すか、他のキーが押されるまではループする。
;

SHIFT_NEXT_KEY_LOOP:
	LD A, (PORT_INDEX)
	AND A
	LD A,1BH
	RET Z ; [EE00]=0、SHIFTキー押されてないならリターンする。
	INC HL
	INC D
	LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
	AND A
	JR NZ, SHIFT_KEY_LOOP ; キーが押下されている時はジャンプする。
	LD A,D
	CP 0FH ; D=A=16バイトチェックしたか？
	JR Z, SHIFT_KEY_NEXT_GET ; 16バイト読み込んで、SHIFTキー以外何も押されていないなら、一番最初のループに戻る
	JR SHIFT_NEXT_KEY_LOOP ; 16バイト読んでないなら、次のメモリを読む。
	
SHIFT_KEY_LOOP:
	CP 04H
	JP Z, CODE_04_SHIFT
	CP 08H
	JP Z, CODE_08_SHIFT
	CP 10H
	JP Z, CODE_10_SHIFT
	CP 20H
	JP Z, CODE_20_SHIFT

CODE_04_SHIFT:
    LD A, L
    AND 0FH
    CP 01H
    JP Z, CODE_1_SHIFT
    CP 02H
    JP Z, CODE_2_SHIFT
    CP 03H
    JP Z, CODE_3_SHIFT
    CP 04H
    JP Z, CODE_4_SHIFT
    CP 05H
    JP Z, CODE_5_SHIFT
    CP 06H
    JP Z, CODE_6_SHIFT
    CP 07H
    JP Z, CODE_7_SHIFT
    CP 08H
    JP Z, CODE_8_SHIFT
    CP 09H
    JP Z, CODE_9_SHIFT
    ; CP 0AH → 0（Shift+0はなし）
    CP 0BH
    JP Z, CODE_MINUS_SHIFT      ; - → =
    CP 0CH
    JP Z, CODE_CARET_SHIFT      ; ^ → ~
    CP 0DH
    JP Z, CODE_BACKSLASH_SHIFT  ; \ → |
    LD A, 0H
    JP SCAN_LOOP_RETURN

CODE_08_SHIFT:
    LD A, L
    AND 0FH
    CP 0BH
    JP Z, CODE_AT_MARK_SHIFT    ; @ → `
    CP 0CH
    JP Z, CODE_L_SQ_PAR_SHIFT   ; [ → {
    LD A, 0H
    JP SCAN_LOOP_RETURN

CODE_10_SHIFT:
    LD A, L
    AND 0FH
    CP 0AH
    JP Z, CODE_SEMI_COLON_SHIFT ; ; → +
    CP 0BH
    JP Z, CODE_COLON_SHIFT      ; : → *
    CP 0CH
    JP Z, CODE_R_SQ_PAR_SHIFT   ; ] → }
    LD A, 0H
    JP SCAN_LOOP_RETURN

CODE_20_SHIFT:
    LD A, L
    AND 0FH
    CP 09H
    JP Z, CODE_COMMA_SHIFT      ; , → 
    CP 0AH
    JP Z, CODE_PERIOD_SHIFT     ; . → >
    ; CP 0BH → /（Shift+/はなし）
    ; CP 0CH → _（Shift+_はなし）
    LD A, 0H
    JP SCAN_LOOP_RETURN

; 文字コード
CODE_1_SHIFT:
    LD A, '!'
    JP SCAN_LOOP_RETURN
CODE_2_SHIFT:
    LD A, 22H          ; "
    JP SCAN_LOOP_RETURN
CODE_3_SHIFT:
    LD A, '#'
    JP SCAN_LOOP_RETURN
CODE_4_SHIFT:
    LD A, '$'
    JP SCAN_LOOP_RETURN
CODE_5_SHIFT:
    LD A, '%'
    JP SCAN_LOOP_RETURN
CODE_6_SHIFT:
    LD A, '&'
    JP SCAN_LOOP_RETURN
CODE_7_SHIFT:
    LD A, 27H          ; '
    JP SCAN_LOOP_RETURN
CODE_8_SHIFT:
    LD A, '('
    JP SCAN_LOOP_RETURN
CODE_9_SHIFT:
    LD A, ')'
    JP SCAN_LOOP_RETURN
CODE_MINUS_SHIFT:
    LD A, '='
    JP SCAN_LOOP_RETURN
CODE_CARET_SHIFT:
    LD A, 7EH          ; ~
    JP SCAN_LOOP_RETURN
CODE_BACKSLASH_SHIFT:
    LD A, 7CH          ; |
    JP SCAN_LOOP_RETURN
CODE_AT_MARK_SHIFT:
    LD A, '`'
    JP SCAN_LOOP_RETURN
CODE_L_SQ_PAR_SHIFT:
    LD A, '{'
    JP SCAN_LOOP_RETURN
CODE_SEMI_COLON_SHIFT:
    LD A, '+'
    JP SCAN_LOOP_RETURN
CODE_COLON_SHIFT:
    LD A, '*'
    JP SCAN_LOOP_RETURN
CODE_R_SQ_PAR_SHIFT:
    LD A, '}'
    JP SCAN_LOOP_RETURN
CODE_COMMA_SHIFT:
    LD A, '<'
    JP SCAN_LOOP_RETURN
CODE_PERIOD_SHIFT:
    LD A, '>'
    JP SCAN_LOOP_RETURN

;=======================================================
;
; Controlキーと同時に押されたキーをゲットするサブルーチン
;
;=======================================================

CONTROL_KEY_NEXT_GET:
	LD HL,PORT_INDEX ; キーボードポートの値が入っているメモリアドレスPORT_INDEX~PORT_INDEX+0xFHのポインタを先頭に戻している。
	LD BC,0FDFH ; DJNZを使うので、B=0xf、C=0xDFにしている。Bがスキャン回数。Cがポート番号
CONTROL_SCAN_LOOP:
	INC C ; 初回の処理で、C=0xDF+1=0xE0となる。
	DI
	IN A,(C)
	EI
	LD (HL),A ; 値を、INIで入れたアドレスと同じところに格納する。
	INC HL ; メモリアドレスをインクリメント。
	DJNZ CONTROL_SCAN_LOOP ; 16回繰り返す

	LD HL,PORT_INDEX ; メモリアドレスポインタをPORT_INDEXの先頭に戻す。
	LD D,0H ; インデックスを 1 にする。
	LD B,0FH ; B=FH=16
	LD E,0H

;
; Controlキーを離すか、他のキーが押されるまではループする。
;

CONTROL_NEXT_KEY_LOOP:
	LD A, (PORT_INDEX)
	AND A
	LD A,1BH
	RET Z ; [EE00]=0、SHIFTキー押されてないならリターンする。
	INC HL
	INC D
	LD A, (HL) ; メモリアドレスからキースキャンの値を取り出す。
	AND A
	JR NZ, CONTROL_KEY_LOOP ; キーが押下されている時はジャンプする。
	LD A,D
	CP 0FH ; D=A=16バイトチェックしたか？
	JR Z, CONTROL_KEY_NEXT_GET ; 16バイト読み込んで、SHIFTキー以外何も押されていないなら、一番最初のループに戻る
	JR CONTROL_NEXT_KEY_LOOP ; 16バイト読んでないなら、次のメモリを読む。
	
CONTROL_KEY_LOOP:
	CP 08H
	JP Z, CODE_08_CONTROL
	CP 10H
	JP Z, CODE_10_CONTROL
	CP 20H
	JP Z, CODE_20_CONTROL

CODE_08_CONTROL:
    LD A, L
    AND 0FH
    CP 03H
    JP Z, CODE_E_CONTROL
    CP 04H
    JP Z, CODE_R_CONTROL
    CP 07H
    JP Z, CODE_U_CONTROL
    CP 0AH
    JP Z, CODE_P_CONTROL
    LD A, 0H
    JP SCAN_LOOP_RETURN

CODE_10_CONTROL:
    LD A, L
    AND 0FH
    CP 02H
    JP Z, CODE_S_CONTROL
    LD A, 0H
    JP SCAN_LOOP_RETURN

CODE_20_CONTROL:
    LD A, L
    AND 0FH
    CP 01H
    JP Z, CODE_Z_CONTROL
    CP 02H
    JP Z, CODE_X_CONTROL
    CP 03H
    JP Z, CODE_C_CONTROL
    LD A, 0H
    JP SCAN_LOOP_RETURN

CODE_E_CONTROL:
    LD A, 05H
    JP SCAN_LOOP_RETURN
CODE_C_CONTROL:
    LD A, 03H
    JP SCAN_LOOP_RETURN
CODE_P_CONTROL:
    LD A, 10H
    JP SCAN_LOOP_RETURN
CODE_R_CONTROL:
    LD A, 12H
    JP SCAN_LOOP_RETURN
CODE_S_CONTROL:
    LD A, 13H
    JP SCAN_LOOP_RETURN
CODE_U_CONTROL:
    LD A, 15H
    JP SCAN_LOOP_RETURN
CODE_X_CONTROL:
    LD A, 18H
    JP SCAN_LOOP_RETURN
CODE_Z_CONTROL:
    LD A, 1AH
    JP SCAN_LOOP_RETURN

;==============================================================
;
; CTC初期化ルーチン
;
;==============================================================
CTC_INIT:
        DI                  ; 割り込み禁止

        ; Iレジスタ設定（IM2テーブルの上位バイト）
        LD   A, 0FFh
        LD   I, A

        ; IM2モード設定
        IM   2

        ; 割り込みベクタテーブル初期化
        ; 0xFF00からの256バイト（128エントリ）をダミーISRで埋める
        LD   HL, IM2_TABLE
        LD   DE, DUMMY_ISR
        LD   B, 128         ; 128エントリ（256バイト）
INIT_LOOP:
        LD   (HL), E        ; 下位バイト
        INC  HL
        LD   (HL), D        ; 上位バイト
        INC  HL
        DJNZ INIT_LOOP

        ; Ch0用ISRアドレスを設定（明示的に0xFF00に書き込む）
        LD   HL, IM2_TABLE  ; HL = 0xFF00
        LD   DE, CTC_CH0_ISR
        LD   (HL), E        ; 下位バイトを0xFF00に
        INC  HL
        LD   (HL), D        ; 上位バイトを0xFF01に

        ; CTCベクタベース設定
        LD   A, VEC_BASE
        OUT  (CTC_CH0), A

        ; Ch0制御ワード設定
        LD   A, 0B5h
        OUT  (CTC_CH0), A

        ; タイムコンスタント設定（156 = 約10ms）
        LD   A, 156
        OUT  (CTC_CH0), A

        EI                  ; 割り込み許可
        RET

;==============================================================
;
; ダミーISR（何もしないでリターン）
;
;==============================================================
DUMMY_ISR:
        EI
        RETI

;==============================================================
;
; CTC Ch0割り込みサービスルーチン
;
;==============================================================

SOFT_TICKS: DB  0       ; ソフトウェアカウンタ (0-4)

;==============================================================
;
; CTC Ch0 ISR ─ リングバッファへの書き込み
;
;==============================================================
CTC_CH0_ISR:
        PUSH AF
        PUSH BC
        PUSH DE
        PUSH HL

        ; 2回に1回 → 20ms 周期
        LD   A, (SOFT_TICKS)
        INC  A
        LD   (SOFT_TICKS), A
        AND  01H
        JR   NZ, ISR_END            ; 奇数回 → スキップ

        ; キースキャン
	    LD   HL, PORT_INDEX
    	LD   BC, 0FDFH          ; B=0Fh (内側スキャン回数), C=DFh (ポート番号)
    	CALL KEY_SCAN			; A = ASCIIコード (0=キーなし)
        OR   A
        JR   Z, ISR_END              ; キーなし

        ; バッファ満杯チェック
        LD   C, A                    ; C = ASCIIコード退避
        LD   A, (pointer_for_write_key_buffer)
        CP   07FH                    ; pointer = 7FH (127) → 満杯
        JR   Z, ISR_END              ; 満杯 → 破棄

        ; input_key_buffer[pointer] へ書き込み
        LD   HL, input_key_buffer
        LD   D, 0
        LD   E, A                    ; DE = pointer (オフセット)
        ADD  HL, DE                  ; HL = &input_key_buffer[pointer]
        LD   (HL), C                 ; ASCIIコードを格納

        ; ポインタを進める
        INC  A
        LD   (pointer_for_write_key_buffer), A

ISR_END:
        POP  HL
        POP  DE
        POP  BC
        POP  AF
        EI
        RETI

;==============================================================
;
; DMA COMMAND CHAIN
;
;==============================================================
DMA_COMMANDS:
	DB 15H,0C3H,0C3H,0C3H,0C3H,0C3H,0C3H
	DB 0BBH,01H,0BFH
	DB 6DH
	DB 0C3H,0FFH,00H,2CH,010H,8DH
	DB hstbuf.@L
	DB hstbuf.@H ; this address is hstbuf address !!!!
	DB 8AH
	DB 0CFH,87H
DMA_WRITE_COMMANDS:
	DB 16H,0C3H,0C3H,0C3H,0C3H,0C3H,0C3H
	DB 83H ; STOP DMA
	DB 79H ; B->A
	DB hstbuf.@L
	DB hstbuf.@H  ; this address is hstbuf address !!!
	DB 00H,0FFH ; 256yte transfer
	DB 14H,28H,8DH
	DB 0C3H,00H ; FDC data register
	DB 8AH
	DB 0CFH,05H
	DB 0CFH,87H

;==============================================================
;
; DMA WBOOT COMMAND CHAIN
;
;==============================================================
DMA_WBOOT_COMMANDS:
	DB 15H,0C3H,0C3H,0C3H,0C3H,0C3H,0C3H
	DB 0BBH,01H,0BFH
	DB 6DH
	DB 0C3H,0FFH,00H,2CH,10H,8DH
wboot_address:	DB 00H,0CCH ; CC00H is 58K MEMORY MODEL
	DB 8AH
	DB 0CFH,87H

;==============================================================
;
; Opening message and copyright message
;
;==============================================================	
OPENMSG:
	DB "SORD M23 CP/M-80 V2.2 58K SYSTEM",00H
;COPYMSG:
;	DB "Copyright 1979 (C) by Digital Research.",CR,LF,00H

;==============================================================
;
; Keyboard map
;
;==============================================================
KEY_MAP:
	DB 0H,'1234567890-=',5CH,08H,0H
	DB 0H,'QWERTYUIOP@',5BH,0DH,0DH,0H
	DB 0H,'ASDFGHJKL',3BH,3AH,5DH,0H,0H,0H
	DB 0H,'ZXCVB',20H,'NM',2CH,2EH,2FH,0H,0H,0H

;=======================
;
; キー入力バッファ
;
;=======================
input_key_buffer:	DS	127	;キー入力バッファ（127文字分）
pointer_for_write_key_buffer:	DS	1	;キーを書き込むポインタ（＝0でカラ、＝7FHでいっぱい）

;==============================================================
;
; Unitialized RAM data areas
;
;==============================================================
sekdsk:		DS	1	;seek disk number
sektrk:		DS	2	;seek track number
seksec:		DS	1	;seek sector number
;
hstdsk:		DS	1	;host disk number
hsttrk:		DS	2	;host track number
hstsec:		DS	1	;host sector number
;
sekhst:		DS	1	;seek shr secshf
hstact:		DS	1	;host active flag
hstwrt:		DS	1	;host written flag
;
unacnt:		DS	1	;unalloc rec cnt
unadsk:		DS	1	;last unalloc disk
unatrk:		DS	2	;last unalloc track
unasec:		DS	1	;last unalloc sector
;
erflag:		DS	1	;error reporting
rsflag:		DS	1	;read sector flag
readop:		DS	1	;1 if read operation
wrtype:		DS	1	;write operation type
dmaadr:		DS	2	;last dma address
hstbuf:		DS	hstsiz	;host buffer
;
;	the remainder of the cbios is reserved uninitialized
;	data area, and does not need to be a Part of the
;	system	memory image (the space must be available,
;	however, between"begdat" and"enddat").
;
track:		DS	2	;two bytes for expansion
sector:		DS	2	;two bytes for expansion
dmaad:		DS	2	;direct memory address
diskno:		DS	1	;disk number 0-15
;
;	scratch ram area for bdos use
begdat	EQU	$	;beginning of data area
dirbf:		DS	128	;scratch directory area
all00:		DS	31	;allocation vector 0
all01:		DS	31	;allocation vector 1
all02:		DS	31	;allocation vector 2
all03:		DS	31	;allocation vector 3
chk00:		DS	16	;check vector 0
chk01:		DS	16	;check vector 1
chk02:		DS	16	;check vector 2
chk03:		DS	16	;check vector 3

CURRENT_LINE:			DS 1	; 現在の行番号
FLAG_ESC_SEQUENCE:		DS 1	; エスケープシーケンスのフラグ
BUFFER_ESCAPE_SEQUENCE:	DS 2	; エスケープシーケンスのバッファ
CURRENT_CURSOR_AT_LINE:	DS 1	; 現在の行のカーソル位置


;==============================================================
;
; key input scan buffer
; 末尾1バイトのアドレスが00であることを期待している。
;
;==============================================================
	ORG KEYBOARD_SCAN_BUFFER

PORT_INDEX:
	DS 16
SHIFT_FLAG:
    DS 1            ; 0x0310：Shiftフラグ（0x20=押下中、0x00=離れている）
CTRL_FLAG:
    DS 1            ; 0x0311：Ctrlフラグ（0x10=押下中、0x00=離れている）
PREV_INDEX:
    DS 16        ; 0x0312: 前回スキャン結果

enddat	EQU	$			; end of data area
datsiz	EQU	$-begdat	; size of data area

	END
